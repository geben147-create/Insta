 "vs": ""}, {"s": 884974, "e": 888197, "zh": "主，公主带来了五谷种子和家畜", "ko": "각각 아내로 맞았고, 공주들이 오곡 씨앗과 가축을 가져와", "t": "", "vs": ""}, {"s": 888197, "e": 890924, "zh": "他们便由此开始农耕生活", "ko": "그때부터 농경 생활을 시작해", "t": "", "vs": ""}, {"s": 890924, "e": 892412, "zh": "建立了丹罗国", "ko": "탐라국을 세웠어요.", "t": "", "vs": ""}, {"s": 892412, "e": 896627, "zh": "也就是济州岛的前身超鲜时代的地方官", "ko": "제주도의 전신이죠. 조선시대 지방관이", "t": "", "vs": ""}, {"s": 896627, "e": 898858, "zh": "在这里修建了三圣殿", "ko": "이곳에 삼성전을 지어", "t": "", "vs": ""}, {"s": 898858, "e": 900842, "zh": "用来供奉三位神仙", "ko": "세 신을 모셨고", "t": "", "vs": ""}, {"s": 900842, "e": 904313, "zh": "用秋两季还会举行祭祀这一传统", "ko": "봄가을로 제사를 지내는 전통이", "t": "", "vs": ""}, {"s": 904313, "e": 908032, "zh": "延续至今济州岛文化最原初的模样", "ko": "지금까지 이어집니다. 제주 문화의 가장 원초적인 모습이", "t": "", "vs": ""}, {"s": 908032, "e": 909520, "zh": "就这样被定格。", "ko": "이렇게 보존돼 있어요.", "t": "", "vs": ""}, {"s": 912070, "e": 914900, "zh": "Killingmesurfing.", "ko": "(노래)", "t": "", "vs": ""}, {"s": 917100, "e": 919730, "zh": "Whenifeelfeellovely.", "ko": "(노래)", "t": "", "vs": ""}, {"s": 922450, "e": 925710, "zh": "Letmeloveyoubaby.", "ko": "(노래)", "t": "", "vs": ""}, {"s": 928840, "e": 931110, "zh": "到solove.", "ko": "(음악)", "t": "", "vs": ""}, {"s": 945800, "e": 947414, "zh": "夜色缓缓降临", "ko": "밤이 천천히 내렸고", "t": "", "vs": ""}, {"s": 947414, "e": 951181, "zh": "我也漫步到了济州市的中心地带。", "ko": "저는 제주시 중심가를 걸었어요.", "t": "", "vs": ""}, {"s": 951181, "e": 955486, "zh": "而在这里，最值得一逛的便是东盟市场。", "ko": "여기서 가장 가볼 만한 곳은 동문시장입니다.", "t": "", "vs": ""}, {"s": 955486, "e": 958715, "zh": "东门市场设立于一九四五年", "ko": "동문시장은 1945년에 생겼고", "t": "", "vs": ""}, {"s": 958715, "e": 960867, "zh": "是济州岛历史最久", "ko": "제주에서 가장 역사가 길고", "t": "", "vs": ""}, {"s": 960867, "e": 963827, "zh": "规模最大的常舍市场之一。", "ko": "규모가 큰 상설시장 중 하나예요.", "t": "", "vs": ""}, {"s": 963827, "e": 966787, "zh": "相比西归浦的美肉来市场", "ko": "서귀포 매일올레시장과 비교하면", "t": "", "vs": ""}, {"s": 966787, "e": 968401, "zh": "这里体量更大", "ko": "이곳이 규모가 더 크고", "t": "", "vs": ""}, {"s": 968401, "e": 970285, "zh": "摊位也更为丰富。", "ko": "가게도 더 다양해요.", "t": "", "vs": ""}, {"s": 970285, "e": 971899, "zh": "水产蔬果干货", "ko": "수산물, 채소·과일, 건어물,", "t": "", "vs": ""}, {"s": 971899, "e": 975666, "zh": "小吃和日用杂货分布在不同区域", "ko": "먹거리와 생활잡화가 구역별로 나뉘어 있어서", "t": "", "vs": ""}, {"s": 975666, "e": 977550, "zh": "逛起来很有层次。", "ko": "구경하는 맛이 있어요.", "t": "", "vs": ""}, {"s": 977630, "e": 981177, "zh": "其中最具代表性的还是水产区", "ko": "그중 대표는 역시 수산물 구역이에요.", "t": "", "vs": ""}, {"s": 981177, "e": 985271, "zh": "济州岛周边海域捞上来的各种海产", "ko": "제주 인근 바다에서 잡은 각종 해산물이", "t": "", "vs": ""}, {"s": 985271, "e": 987455, "zh": "在摊位上一字排开", "ko": "가판대에 쭉 늘어서 있어서", "t": "", "vs": ""}, {"s": 987455, "e": 990457, "zh": "很能体现海岛市场的气质。", "ko": "섬 시장다운 분위기가 잘 느껴져요.", "t": "", "vs": ""}, {"s": 990457, "e": 992640, "zh": "再往里走，猪蹄泡菜", "ko": "더 안쪽에는 족발, 김치,", "t": "", "vs": ""}, {"s": 992640, "e": 994823, "zh": "海带、鲶鱼、干黑猪肉", "ko": "미역, 갈치, 말린 흑돼지고기가 있어요.", "t": "", "vs": ""}, {"s": 994823, "e": 995915, "zh": "怎么说呢？", "ko": "뭐랄까,", "t": "", "vs": ""}, {"s": 995915, "e": 997552, "zh": "能忍住在这里", "ko": "여기서 참고", "t": "", "vs": ""}, {"s": 997552, "e": 999190, "zh": "不吃点东西的", "ko": "아무것도 안 먹는 사람은", "t": "", "vs": ""}, {"s": 999190, "e": 1001100, "zh": "做什么都会成功。", "ko": "뭘 해도 성공할 거예요.", "t": "", "vs": ""}, {"s": 1001100, "e": 1003011, "zh": "这趟济州岛环游", "ko": "이번 제주 일주는", "t": "", "vs": ""}, {"s": 1003011, "e": 1005467, "zh": "我原本没有太多期待", "ko": "큰 기대가 없었는데", "t": "", "vs": ""}, {"s": 1005467, "e": 1010380, "zh": "但一整圈体验下来比我想象中要丰富很多。", "ko": "한 바퀴 돌고 나니 상상보다 훨씬 풍성했어요.", "t": "", "vs": ""}, {"s": 1010460, "e": 1013433, "zh": "东蟹像是步入一场童话", "ko": "동쪽은 동화 속으로 들어간 느낌이었고", "t": "", "vs": ""}, {"s": 1013433, "e": 1016108, "zh": "成山日出峰，身体可知。", "ko": "성산일출봉도 그렇고,", "t": "", "vs": ""}, {"s": 1016108, "e": 1020568, "zh": "牛岛把火山草坡和海岸线铺展开来", "ko": "우도는 화산과 초원 언덕, 해안선을 펼쳐 줬어요.", "t": "", "vs": ""}, {"s": 1020568, "e": 1023541, "zh": "西蟹适合追逐一场落日", "ko": "서쪽은 노을을 쫓기 좋아서", "t": "", "vs": ""}, {"s": 1023541, "e": 1026217, "zh": "看太阳慢慢沉入海面。", "ko": "해가 천천히 바다에 잠기는 걸 봤어요.", "t": "", "vs": ""}, {"s": 1026217, "e": 1031866, "zh": "南蟹则像在寻找一段过往瀑布海女老街之间", "ko": "남쪽은 지난 시간을 찾는 느낌이라 폭포, 해녀, 옛 거리 사이에", "t": "", "vs": ""}, {"s": 1031866, "e": 1035136, "zh": "藏着济州岛等厚重的一面。", "ko": "제주의 묵직한 면이 숨어 있었어요.", "t": "", "vs": ""}, {"s": 1035136, "e": 1039298, "zh": "到了北线，我又走入一片人海市场", "ko": "북쪽에선 사람 가득한 시장으로 들어갔는데", "t": "", "vs": ""}, {"s": 1039298, "e": 1041380, "zh": "街道灯光和人群。", "ko": "거리의 불빛과 사람들이", "t": "", "vs": ""}, {"s": 1041460, "e": 1045226, "zh": "让这里重新回到真实的城市生活中。", "ko": "이곳을 다시 진짜 도시 생활로 돌려놨어요.", "t": "", "vs": ""}, {"s": 1045226, "e": 1046983, "zh": "而且不论哪条线", "ko": "그리고 어느 코스든", "t": "", "vs": ""}, {"s": 1046983, "e": 1048490, "zh": "海水都很清澈", "ko": "바닷물은 맑았고", "t": "", "vs": ""}, {"s": 1048490, "e": 1050247, "zh": "海岸线也很舒服。", "ko": "해안선도 편안했어요.", "t": "", "vs": ""}, {"s": 1050247, "e": 1051754, "zh": "火山地貌、草坡", "ko": "화산 지형, 초원 언덕,", "t": "", "vs": ""}, {"s": 1051754, "e": 1056525, "zh": "悬崖、日落和城市街道也有着各自不同的气质。", "ko": "절벽, 노을, 도시 거리 모두 각자의 분위기가 있었어요.", "t": "", "vs": ""}, {"s": 1056525, "e": 1061295, "zh": "济州岛给我的另一个印象在整体环境很干净。", "ko": "제주의 또 다른 인상은 전체적으로 환경이 깨끗하다는 거예요.", "t": "good", "vs": ""}, {"s": 1061295, "e": 1063053, "zh": "街道也比较整洁", "ko": "거리도 꽤 깔끔하고", "t": "good", "vs": ""}, {"s": 1063053, "e": 1068577, "zh": "很多地方能看到中文标识部分店铺也可以使用微信", "ko": "중국어 표지판이 많이 보이고 일부 가게는 위챗페이", "t": "good", "vs": ""}, {"s": 1068577, "e": 1071339, "zh": "和支付宝，能明显感到这里。", "ko": "알리페이도 돼서, 확실히 느껴져요.", "t": "", "vs": ""}, {"s": 1071339, "e": 1073598, "zh": "在认真服务中国游客", "ko": "중국 관광객을 진지하게 대하고 있다는 걸요.", "t": "good", "vs": ""}, {"s": 1073598, "e": 1079122, "zh": "所以整个旅行过程的便利度和体验感都比我预想中", "ko": "그래서 여행 전반의 편의성과 만족도가 예상보다", "t": "good", "vs": ""}, {"s": 1079122, "e": 1079624, "zh": "要好。", "ko": "좋았어요.", "t": "", "vs": ""}, {"s": 1079624, "e": 1083140, "zh": "当然，如果用顶尖海岛的标注去看。", "ko": "물론 최고급 휴양섬 기준으로 보면", "t": "eval", "vs": "기타"}, {"s": 1083140, "e": 1085734, "zh": "济州岛确实算不上经验", "ko": "제주는 솔직히 대단하진 않아요.", "t": "bad", "vs": ""}, {"s": 1085734, "e": 1088069, "zh": "但它的优势也很明确。", "ko": "하지만 장점도 분명해요.", "t": "good", "vs": ""}, {"s": 1088069, "e": 1089885, "zh": "距离近美，切方便", "ko": "가깝고 편하고", "t": "good", "vs": ""}, {"s": 1089885, "e": 1091441, "zh": "自然，风景不错。", "ko": "자연 풍경도 괜찮고요.", "t": "good", "vs": ""}, {"s": 1091441, "e": 1096889, "zh": "同时还能感受到一些异国城市和海岛的生活氛围。", "ko": "이국 도시와 섬의 생활 분위기도 느낄 수 있어요.", "t": "good", "vs": ""}, {"s": 1096889, "e": 1098964, "zh": "门槛不高，节奏轻松", "ko": "문턱 낮고 리듬도 느긋하고", "t": "good", "vs": ""}, {"s": 1098964, "e": 1102078, "zh": "距离不远，又能稍微换个环境", "ko": "멀지 않으면서 환경을 살짝 바꿀 수 있죠.", "t": "good", "vs": ""}, {"s": 1102078, "e": 1103634, "zh": "这就是济州岛。", "ko": "이게 제주도예요.", "t": "good", "vs": ""}, {"s": 1103634, "e": 1105710, "zh": "对我而言的吸引力。", "ko": "저에게는 그게 매력이에요.", "t": "", "vs": ""}, {"s": 1106700, "e": 1109581, "zh": "在享受过济州岛的绝佳风光后", "ko": "제주의 멋진 풍경을 즐겼으니", "t": "", "vs": ""}, {"s": 1109581, "e": 1114237, "zh": "我们这就进入大家催更已久的拍照技巧分享环节。", "ko": "이제 여러분이 오래 기다린 촬영 팁 공유 시간입니다.", "t": "", "vs": ""}, {"s": 1114237, "e": 1115788, "zh": "这里要说明一下", "ko": "먼저 말씀드리면", "t": "", "vs": ""}, {"s": 1115788, "e": 1118449, "zh": "虽然我是以大家按吃六为例", "ko": "저는 액션 6을 예로 들지만", "t": "", "vs": ""}, {"s": 1118449, "e": 1121774, "zh": "但其中的创作思路与技巧是通用的。", "ko": "창작 아이디어와 요령은 어디서나 통해요.", "t": "", "vs": ""}, {"s": 1121774, "e": 1124434, "zh": "希望能帮你在之后的旅行里", "ko": "다음 여행에서 여러분이", "t": "", "vs": ""}, {"s": 1124434, "e": 1126873, "zh": "把旅行场景拍在各有层次", "ko": "장면마다 층과", "t": "", "vs": ""}, {"s": 1126873, "e": 1130420, "zh": "各有氛围，打造独属于自己的旅行回忆。", "ko": "분위기를 살려 나만의 여행 추억을 만들 수 있길 바랍니다.", "t": "", "vs": ""}, {"s": 1130700, "e": 1132367, "zh": "技巧一，先找前景", "ko": "팁 1, 전경부터 찾고", "t": "", "vs": ""}, {"s": 1132367, "e": 1133320, "zh": "再拍大景。", "ko": "넓은 풍경을 찍으세요.", "t": "", "vs": ""}, {"s": 1133320, "e": 1138562, "zh": "第一个技巧，适合济州岛东线这种海岸公路山峰交错", "ko": "첫 번째 팁은 제주 동쪽처럼 해안도로와 산봉우리가 교차하는", "t": "", "vs": ""}, {"s": 1138562, "e": 1139515, "zh": "的大场景。", "ko": "큰 장면에 좋아요.", "t": "", "vs": ""}, {"s": 1139515, "e": 1140944, "zh": "拍这种大风景", "ko": "이런 큰 풍경을 찍을 땐", "t": "", "vs": ""}, {"s": 1140944, "e": 1143565, "zh": "我会尽量选择大光比场景", "ko": "명암 차가 큰 장면을 고릅니다.", "t": "", "vs": ""}, {"s": 1143565, "e": 1146900, "zh": "比如阳光很强的海面背光的礁石", "ko": "햇빛 강한 바다, 역광의 바위,", "t": "", "vs": ""}, {"s": 1146900, "e": 1149044, "zh": "或者一边是天空高光", "ko": "또는 한쪽은 하늘의 밝은 부분,", "t": "", "vs": ""}, {"s": 1149044, "e": 1151427, "zh": "一边是地面暗部的画面", "ko": "한쪽은 땅의 어두운 부분인 장면이요.", "t": "", "vs": ""}, {"s": 1151427, "e": 1154286, "zh": "很多人拍海边习惯站着平拍。", "ko": "많은 분이 바닷가에서 서서 수평으로 찍는데", "t": "", "vs": ""}, {"s": 1154286, "e": 1157621, "zh": "最后画面只剩下一片海和一片天", "ko": "결국 화면에는 바다와 하늘만 남아서", "t": "", "vs": ""}, {"s": 1157621, "e": 1158812, "zh": "看起来很空。", "ko": "허전해 보여요.", "t": "", "vs": ""}, {"s": 1158812, "e": 1163577, "zh": "我的方法是先把大家action六放低一点", "ko": "제 방법은 먼저 액션 6을 낮게 두고", "t": "", "vs": ""}, {"s": 1163577, "e": 1167628, "zh": "用礁石草丛路面或者公路边线作为前景", "ko": "바위, 풀숲, 노면이나 도로 가장자리선을 전경으로 써서", "t": "", "vs": ""}, {"s": 1167628, "e": 1169772, "zh": "让画面形成前景海面", "ko": "전경, 바다,", "t": "", "vs": ""}, {"s": 1169772, "e": 1171440, "zh": "远山天空的层次。", "ko": "먼 산, 하늘의 층을 만드는 거예요.", "t": "", "vs": ""}, {"s": 1171440, "e": 1174194, "zh": "这时候我不会一倍开大光圈", "ko": "이때 조리개를 최대로 열지 않고", "t": "", "vs": ""}, {"s": 1174194, "e": 1178786, "zh": "而是会根据光线用f二点零到四点零可变光圈", "ko": "빛에 따라 f2.0에서 4.0 사이로 조절해요.", "t": "", "vs": ""}, {"s": 1178786, "e": 1182000, "zh": "光线充足，画面层次比较多的时候", "ko": "빛이 충분하고 층이 많을 땐", "t": "", "vs": ""}, {"s": 1182000, "e": 1187050, "zh": "小一点的光圈可以让前景海面远处的山都保持清楚", "ko": "조리개를 조금 조이면 전경, 바다, 먼 산이 다 또렷하고", "t": "", "vs": ""}, {"s": 1187050, "e": 1189346, "zh": "，也能更好保证整体画屏。", "ko": "전체 화질도 더 잘 보장돼요.", "t": "", "vs": ""}, {"s": 1189346, "e": 1194396, "zh": "再加上一点一分之一英寸方形传感器的四k自由裁", "ko": "게다가 1/1.3인치 정사각 센서의 4K 자유 크롭으로", "t": "", "vs": ""}, {"s": 1194396, "e": 1195774, "zh": "铅同一个镜头", "ko": "한 번 찍은 영상을", "t": "", "vs": ""}, {"s": 1195774, "e": 1197840, "zh": "后期既可以裁成横屏", "ko": "후반에 가로로도", "t": "", "vs": ""}, {"s": 1197840, "e": 1199447, "zh": "也可以裁成竖屏。", "ko": "세로로도 자를 수 있어요.", "t": "", "vs": ""}, {"s": 1199447, "e": 1201283, "zh": "对于旅行拍摄来说", "ko": "여행 촬영에서", "t": "", "vs": ""}, {"s": 1201283, "e": 1202661, "zh": "这一点很实用。", "ko": "이게 아주 실용적이에요.", "t": "", "vs": ""}, {"s": 1202661, "e": 1205186, "zh": "很多时候一个机位拍好了", "ko": "한 번 잘 찍어두면", "t": "", "vs": ""}, {"s": 1205186, "e": 1207023, "zh": "后期还能重新构图", "ko": "후반에 다시 구도를 잡을 수 있어서", "t": "", "vs": ""}, {"s": 1207023, "e": 1208630, "zh": "可以说十分方便。", "ko": "정말 편하죠.", "t": "", "vs": ""}, {"s": 1209070, "e": 1211827, "zh": "技巧二，先保高光再拍日落。", "ko": "팁 2, 하이라이트부터 지키고 노을을 찍으세요.", "t": "", "vs": ""}, {"s": 1211827, "e": 1215336, "zh": "第二个技巧，适合西线的海边公路", "ko": "두 번째 팁은 서쪽 해안도로,", "t": "", "vs": ""}, {"s": 1215336, "e": 1218595, "zh": "风车、海岸和日落等大光笔场景。", "ko": "풍차, 해안과 노을 같은 명암 큰 장면에 좋아요.", "t": "", "vs": ""}, {"s": 1218595, "e": 1221352, "zh": "记着挡西线最适合拍日落", "ko": "서쪽이 노을 찍기 가장 좋지만", "t": "", "vs": ""}, {"s": 1221352, "e": 1225112, "zh": "但日落和海面高光其实很容易翻车", "ko": "노을과 바다 반사광은 사실 실패하기 쉬워요.", "t": "", "vs": ""}, {"s": 1225112, "e": 1228621, "zh": "因为太阳天空和海面反光都很亮", "ko": "태양, 하늘, 바다 반사광은 아주 밝고", "t": "", "vs": ""}, {"s": 1228621, "e": 1232882, "zh": "地面人物和礁石又很暗地果直接自动拍", "ko": "땅의 사람과 바위는 어두워서 자동으로 찍으면", "t": "", "vs": ""}, {"s": 1232882, "e": 1235389, "zh": "很容易出现天空一片白", "ko": "하늘은 하얗고", "t": "", "vs": ""}, {"s": 1235389, "e": 1236642, "zh": "下面一片黑。", "ko": "아래는 시꺼멓게 나오기 쉬워요.", "t": "", "vs": ""}, {"s": 1236642, "e": 1240652, "zh": "所以我拍这里画面时会稍微压低曝光", "ko": "그래서 저는 노출을 약간 낮춰서", "t": "", "vs": ""}, {"s": 1240652, "e": 1243660, "zh": "优先保住天空和海面的高光", "ko": "하늘과 바다의 하이라이트를 먼저 지켜요.", "t": "", "vs": ""}, {"s": 1243660, "e": 1246418, "zh": "构图上，不要只对着太阳拍", "ko": "구도에서는 태양만 정면으로 찍지 말고", "t": "", "vs": ""}, {"s": 1246418, "e": 1250930, "zh": "可以让人物车栏杆或者海边公路进入画面。", "ko": "사람, 차, 난간, 해안도로를 넣어서", "t": "", "vs": ""}, {"s": 1250930, "e": 1253053, "zh": "作为剪影或者引导线", "ko": "실루엣이나 유도선으로 쓰면", "t": "", "vs": ""}, {"s": 1253053, "e": 1254941, "zh": "让画面更有故事感。", "ko": "화면에 이야기가 생겨요.", "t": "", "vs": ""}, {"s": 1254941, "e": 1256829, "zh": "如果海面反光很强", "ko": "바다 반사광이 강하거나", "t": "", "vs": ""}, {"s": 1256829, "e": 1259425, "zh": "或者太阳已经接近地平线", "ko": "태양이 수평선에 가까울 땐", "t": "", "vs": ""}, {"s": 1259425, "e": 1264144, "zh": "我会把大疆f六六的光圈切到f四点零小光圈", "ko": "DJI 액션 6의 조리개를 f4.0 작은 조리개로 바꿔서", "t": "", "vs": ""}, {"s": 1264144, "e": 1267684, "zh": "能让远处海岸线和天空层次更清楚。", "ko": "먼 해안선과 하늘의 층을 더 선명하게 해요.", "t": "", "vs": ""}, {"s": 1267684, "e": 1270279, "zh": "技巧三，先定影调再拍街道。", "ko": "팁 3, 톤부터 정하고 거리를 찍으세요.", "t": "", "vs": ""}, {"s": 1270279, "e": 1274291, "zh": "第三个技巧适合拍摄北线这种城市街道", "ko": "세 번째 팁은 북쪽 같은 도시 거리,", "t": "", "vs": ""}, {"s": 1274291, "e": 1278066, "zh": "海边咖啡馆、高高小店等更人文的画面。", "ko": "바닷가 카페, 작은 가게 등 인문적인 장면에 좋아요.", "t": "", "vs": ""}, {"s": 1278066, "e": 1281370, "zh": "这种场景不一定要拍的多么宏大", "ko": "이런 장면은 꼭 웅장하게 찍을 필요 없고", "t": "", "vs": ""}, {"s": 1281370, "e": 1284910, "zh": "重点是把人在环境里的感觉拍出来。", "ko": "사람이 환경 속에 있는 느낌을 담는 게 핵심이에요.", "t": "", "vs": ""}, {"s": 1284990, "e": 1287311, "zh": "比如从海边小店前走过", "ko": "예를 들어 바닷가 가게 앞을 지나가거나", "t": "", "vs": ""}, {"s": 1287311, "e": 1288703, "zh": "坐在窗边看海", "ko": "창가에 앉아 바다를 보거나", "t": "", "vs": ""}, {"s": 1288703, "e": 1291256, "zh": "或者沿着港口街道慢慢走。", "ko": "항구 거리를 천천히 걷는 장면이요.", "t": "", "vs": ""}, {"s": 1291256, "e": 1294738, "zh": "这些画面如果只用普通广角随手拍", "ko": "이런 장면을 일반 광각으로 대충 찍으면", "t": "", "vs": ""}, {"s": 1294738, "e": 1296595, "zh": "很容易拍成游客照。", "ko": "관광객 사진이 되기 쉬워요.", "t": "", "vs": ""}, {"s": 1296595, "e": 1301701, "zh": "所以我会先用大疆action六的机内胶片影调", "ko": "그래서 저는 먼저 액션 6의 내장 필름 톤으로", "t": "", "vs": ""}, {"s": 1301701, "e": 1304022, "zh": "，直接给画面定一个氛围。", "ko": "화면 분위기부터 정해요.", "t": "", "vs": ""}, {"s": 1304022, "e": 1307271, "zh": "晴天海边蓝天草地这种清透场景", "ko": "맑은 날 바다, 푸른 하늘, 초원 같은 투명한 장면에는", "t": "", "vs": ""}, {"s": 1307271, "e": 1309360, "zh": "我会用NC或者CC", "ko": "NC나 CC를 써서", "t": "", "vs": ""}, {"s": 1309360, "e": 1311449, "zh": "让蓝色和绿色更干净。", "ko": "파랑과 초록이 더 깨끗하게 나오게 해요.", "t": "", "vs": ""}, {"s": 1311449, "e": 1313538, "zh": "如果是在老街咖啡馆", "ko": "오래된 거리 카페나", "t": "", "vs": ""}, {"s": 1313538, "e": 1318412, "zh": "小店门口，我会用FE画面会更有一点复古街拍感。", "ko": "가게 앞에서는 FE를 쓰는데 복고풍 스트리트 감성이 더 나요.", "t": "", "vs": ""}, {"s": 1318412, "e": 1320733, "zh": "同时，我会配合日常广角", "ko": "동시에 일상 광각을 써서", "t": "", "vs": ""}, {"s": 1320733, "e": 1323286, "zh": "把人物和环境一起收进来。", "ko": "인물과 환경을 함께 담아요.", "t": "", "vs": ""}, {"s": 1323286, "e": 1325840, "zh": "它和普通超广角不太一样。", "ko": "일반 초광각과는 좀 달라서", "t": "", "vs": ""}, {"s": 1325840, "e": 1328498, "zh": "不会把人物边缘拉的太夸张", "ko": "인물 가장자리가 과하게 늘어나지 않고", "t": "", "vs": ""}, {"s": 1328498, "e": 1330714, "zh": "更适合拍旅行里的街道", "ko": "여행 중 거리,", "t": "", "vs": ""}, {"s": 1330714, "e": 1334259, "zh": "人像和环境关系拍这种城市漫步画面。", "ko": "인물과 환경 관계를 찍는 이런 도시 산책 장면에 더 맞아요.", "t": "", "vs": ""}, {"s": 1334259, "e": 1337805, "zh": "我会尽量让人物不要站在画面正中间", "ko": "인물은 되도록 화면 한가운데 세우지 않고", "t": "", "vs": ""}, {"s": 1337805, "e": 1340242, "zh": "而是放在三分之一的位置", "ko": "3분의 1 지점에 두고", "t": "", "vs": ""}, {"s": 1340242, "e": 1341571, "zh": "旁边流出街道", "ko": "옆에 거리,", "t": "", "vs": ""}, {"s": 1341571, "e": 1343344, "zh": "窗户、海面或者电招", "ko": "창문, 바다나 간판을 남겨요.", "t": "", "vs": ""}, {"s": 1343344, "e": 1346224, "zh": "这让观众看到的不只是一个人", "ko": "그러면 보는 사람은 그냥 한 사람이 아니라", "t": "", "vs": ""}, {"s": 1346224, "e": 1349770, "zh": "而是一个人站在济州岛的某个空间里。", "ko": "제주의 어느 공간에 서 있는 사람을 보게 돼요.", "t": "", "vs": ""}, {"s": 1350230, "e": 1352045, "zh": "技巧四，先分光线", "ko": "팁 4, 빛부터 나누고", "t": "", "vs": ""}, {"s": 1352045, "e": 1353083, "zh": "再拍夜景。", "ko": "야경을 찍으세요.", "t": "", "vs": ""}, {"s": 1353083, "e": 1355418, "zh": "第四个技巧，关于夜景", "ko": "네 번째 팁은 야경이에요.", "t": "", "vs": ""}, {"s": 1355418, "e": 1358012, "zh": "夜景不只是把画面拍亮", "ko": "야경은 화면을 밝게 찍는 게 다가 아니에요.", "t": "", "vs": ""}, {"s": 1358012, "e": 1360606, "zh": "其实可以分成两种情况", "ko": "사실 두 경우로 나뉘어요.", "t": "", "vs": ""}, {"s": 1360606, "e": 1362940, "zh": "一种是环境真的很暗", "ko": "하나는 환경이 정말 어두운 경우,", "t": "", "vs": ""}, {"s": 1362940, "e": 1365016, "zh": "比如小巷、车边餐厅", "ko": "예를 들어 골목, 길가 식당,", "t": "", "vs": ""}, {"s": 1365016, "e": 1368388, "zh": "便利店门口，另一种是灯光很多", "ko": "편의점 앞이고, 다른 하나는 조명이 많은 경우,", "t": "", "vs": ""}, {"s": 1368388, "e": 1369944, "zh": "比如街灯、车灯", "ko": "가로등, 차 불빛,", "t": "", "vs": ""}, {"s": 1369944, "e": 1373835, "zh": "电照、橱窗，两种夜景拍法是不一样的。", "ko": "네온, 쇼윈도 같은 곳으로, 촬영법이 서로 달라요.", "t": "", "vs": ""}, {"s": 1373835, "e": 1375910, "zh": "如果是在暗光环境", "ko": "어두운 환경이라면", "t": "", "vs": ""}, {"s": 1375910, "e": 1381358, "zh": "我会用超级夜景模式并手动选择f二点零大光圈", "ko": "슈퍼 나이트 모드로 f2.0 대구경을 수동 선택해요.", "t": "", "vs": ""}, {"s": 1381358, "e": 1383693, "zh": "可以带来更多进光量", "ko": "빛이 더 많이 들어와서", "t": "", "vs": ""}, {"s": 1383693, "e": 1385768, "zh": "让画面更亮、更干净", "ko": "화면이 더 밝고 깨끗해지고", "t": "", "vs": ""}, {"s": 1385768, "e": 1389400, "zh": "也能减少晚上常见的噪点和弧感。", "ko": "밤에 흔한 노이즈와 색 번짐도 줄어요.", "t": "", "vs": ""}, {"s": 1389480, "e": 1393891, "zh": "这个时候的重点是先把夜晚的细节保留下来", "ko": "이때는 밤의 디테일을 먼저 살려서", "t": "", "vs": ""}, {"s": 1393891, "e": 1397142, "zh": "让观众看清楚你当时身处的环境。", "ko": "그때 있던 환경이 보이게 하는 게 포인트예요.", "t": "", "vs": ""}, {"s": 1397142, "e": 1399929, "zh": "如果画面里本来就有很多灯", "ko": "화면에 원래 조명이 많다면", "t": "", "vs": ""}, {"s": 1399929, "e": 1401322, "zh": "比如路灯、车灯", "ko": "가로등, 차 불빛,", "t": "", "vs": ""}, {"s": 1401322, "e": 1405502, "zh": "便利店招牌，我反而会切到f四点零小光圈", "ko": "편의점 간판 같은 건 오히려 f4.0 작은 조리개로 바꿔서", "t": "", "vs": ""}, {"s": 1405502, "e": 1408520, "zh": "可以把这些点状光源拍出星芒", "ko": "점광원이 별 모양 빛갈라짐이 되게 해요.", "t": "", "vs": ""}, {"s": 1408520, "e": 1411539, "zh": "让普通的灯光变成画面的氛围。", "ko": "평범한 불빛이 분위기가 돼요.", "t": "", "vs": ""}, {"s": 1411539, "e": 1413164, "zh": "点拍星芒的时候", "ko": "빛갈라짐을 찍을 땐", "t": "", "vs": ""}, {"s": 1413164, "e": 1415718, "zh": "我一般不会把灯放在中间", "ko": "보통 조명을 한가운데 두지 않고", "t": "", "vs": ""}, {"s": 1415718, "e": 1417576, "zh": "而是放在画面边缘", "ko": "화면 가장자리에 두거나", "t": "", "vs": ""}, {"s": 1417576, "e": 1419434, "zh": "或者利用玻璃车窗", "ko": "유리창,", "t": "", "vs": ""}, {"s": 1419434, "e": 1422917, "zh": "地面反光，让灯光在画面里形成层次。", "ko": "바닥 반사를 활용해서 빛에 층을 줘요.", "t": "", "vs": ""}, {"s": 1422917, "e": 1425935, "zh": "这样济州岛的夜晚就不只是亮", "ko": "그러면 제주의 밤이 그냥 밝은 게 아니라", "t": "", "vs": ""}, {"s": 1425935, "e": 1428257, "zh": "而是有了明确的记忆点。", "ko": "분명한 기억 포인트가 생겨요.", "t": "", "vs": ""}, {"s": 1428257, "e": 1430580, "zh": "而以夜景的逻辑很简单。", "ko": "야경 원리는 간단해요.", "t": "", "vs": ""}, {"s": 1430580, "e": 1433829, "zh": "暗的地方用f二点零把画面拍干净", "ko": "어두운 곳은 f2.0으로 화면을 깨끗하게,", "t": "", "vs": ""}, {"s": 1433829, "e": 1437728, "zh": "灯多的地方，用f四点零把光拍出形状好了", "ko": "조명 많은 곳은 f4.0으로 빛에 모양을 주세요. 자, 이렇게", "t": "", "vs": ""}, {"s": 1437728, "e": 1439894, "zh": "四个拍摄技巧分享完毕", "ko": "네 가지 촬영 팁 공유를 마쳤어요.", "t": "", "vs": ""}, {"s": 1439894, "e": 1442493, "zh": "我们记住的节目也接近尾声", "ko": "오늘 방송도 끝나갑니다.", "t": "", "vs": ""}, {"s": 1442493, "e": 1445959, "zh": "不知道这样实拍与技巧相结合的节目", "ko": "이렇게 실촬영과 팁을 합친 방송,", "t": "", "vs": ""}, {"s": 1445959, "e": 1447259, "zh": "大家喜不喜欢？", "ko": "어떠셨나요?", "t": "", "vs": ""}, {"s": 1447259, "e": 1450291, "zh": "作为一名习惯用手机拍摄的博主", "ko": "평소 폰으로 촬영하던 블로거로서", "t": "", "vs": ""}, {"s": 1450291, "e": 1455057, "zh": "这次大家安十六的体验可以说给了我更多视角和可", "ko": "이번 액션 6 체험은 더 많은 시각과 가능성을", "t": "", "vs": ""}, {"s": 1455057, "e": 1455923, "zh": "能性很多。", "ko": "많이 줬어요.", "t": "", "vs": ""}, {"s": 1455923, "e": 1460039, "zh": "以前用手机不太方便完成的低机位运动视角", "ko": "전엔 폰으로 하기 불편했던 로우앵글 스포츠 시점,", "t": "", "vs": ""}, {"s": 1460039, "e": 1461989, "zh": "夜景星芒和自由彩铅", "ko": "야경 별빛, 자유 크롭이", "t": "", "vs": ""}, {"s": 1461989, "e": 1465888, "zh": "这次都变成了旅行里可以随手尝试的画面。", "ko": "이번엔 여행 중 가볍게 시도할 수 있는 화면이 됐어요.", "t": "", "vs": ""}, {"s": 1465888, "e": 1470653, "zh": "这其实也与狼台一直想传递的理念吻合旅行拍摄不", "ko": "이건 랑타이가 늘 전하고 싶은 생각과도 같아요. 여행 촬영은", "t": "", "vs": ""}, {"s": 1470653, "e": 1472170, "zh": "一定要多么复杂。", "ko": "꼭 복잡할 필요 없어요.", "t": "", "vs": ""}, {"s": 1472170, "e": 1475051, "zh": "重要的是，当你路过一条街", "ko": "중요한 건 거리 하나,", "t": "", "vs": ""}, {"s": 1475051, "e": 1478718, "zh": "一片海，一场日落或者一盏街灯时", "ko": "바다 하나, 노을이나 가로등 하나를 지날 때", "t": "", "vs": ""}, {"s": 1478718, "e": 1482647, "zh": "可以忘记设备不费心思的留下美好", "ko": "장비는 잊고 애쓰지 않고 좋은 순간을 남기는 거예요.", "t": "", "vs": ""}, {"s": 1482647, "e": 1483694, "zh": "感谢大家。", "ko": "감사합니다.", "t": "", "vs": ""}, {"s": 1483694, "e": 1486576, "zh": "看到最后我们下期釜山见", "ko": "끝까지 봐주셔서 감사해요. 다음 편은 부산에서 만나요.", "t": "", "vs": ""}, {"s": 1486576, "e": 1487100, "zh": "拜拜。", "ko": "안녕.", "t": "", "vs": ""}], "frames": [{"i": 3, "f": "BILI-116_3.jpg"}, {"i": 63, "f": "BILI-116_63.jpg"}, {"i": 126, "f": "BILI-116_126.jpg"}, {"i": 156, "f": "BILI-116_156.jpg"}, {"i": 268, "f": "BILI-116_268.jpg"}, {"i": 276, "f": "BILI-116_276.jpg"}]}