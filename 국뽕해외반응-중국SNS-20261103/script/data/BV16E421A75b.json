  "lines": [
    {
      "s": 0.0,
      "e": 6.44,
      "zh": "都内の人気ラーメン店のランチタイム 食事をしている人の様子を見てみると",
      "ko": ""
    },
    {
      "s": 6.44,
      "e": 16.6,
      "zh": "あちらのシャツの男性イヤホンつけてますね 両耳にイヤホンをつけたままラーメンを食べています",
      "ko": ""
    },
    {
      "s": 16.6,
      "e": 26.9,
      "zh": "さらに別のお客さんはラーメンが来てからイヤホンをつけ食べ始めました この食事イヤホンをめぐって",
      "ko": ""
    },
    {
      "s": 26.9,
      "e": 36.28,
      "zh": "店主がXに注意喚起を投稿したことがきっかけとなり なぜか中国で物議を醸す事態に発展しているのです",
      "ko": ""
    },
    {
      "s": 36.28,
      "e": 47.48,
      "zh": "店内でイヤホンつけるのをやめてほしい こう訴えたのは家系ラーメンの武道家の店主です",
      "ko": ""
    },
    {
      "s": 49.62,
      "e": 56.32,
      "zh": "まずイヤホンお客さんがつけられている状態で 接客っていうのがまず成り立たない",
      "ko": ""
    },
    {
      "s": 56.32,
      "e": 62.5,
      "zh": "ラーメンのお好みをお伺いした際に イヤホンをつけているから聞こえない 会話が成り立たない",
      "ko": ""
    },
    {
      "s": 62.5,
      "e": 69.7,
      "zh": "出来上がったラーメンを提供する際に 声をかけても気づいてもらえないなど",
      "ko": ""
    },
    {
      "s": 69.7,
      "e": 74.94,
      "zh": "困ることが起きるため注意喚起をSNSに投稿したといいます",
      "ko": ""
    },
    {
      "s": 77.52,
      "e": 85.32,
      "zh": "一方お客さんはなぜイヤホンをつけてラーメンを食べるのか 理由を聞きました",
      "ko": ""
    },
    {
      "s": 85.32,
      "e": 100.4,
      "zh": "イヤホンをつけることでおいしいラーメンに 集中して食事ができると説明",
      "ko": ""
    },
    {
      "s": 101.62,
      "e": 109.56,
      "zh": "こちらの男性は注文する際には声が聞こえるように イヤホンを調整するなど対応していたといいます",
      "ko": ""
    },
    {
      "s": 109.56,
      "e": 115.82,
      "zh": "投稿されているので全然知らなかったので もうちょっと気をつけてみようかなとは思いました",
      "ko": ""
    },
    {
      "s": 115.82,
      "e": 122.04,
      "zh": "中にはイヤホンをつけ ゲームや動画を見ながら食事をする人も",
      "ko": ""
    },
    {
      "s": 122.04,
      "e": 127.96,
      "zh": "こうした影響で回転率が下がるなど マイナスな影響が出ています",
      "ko": ""
    },
    {
      "s": 129.08,
      "e": 137.44,
      "zh": "店主によるとイヤホンをつけながら食べる客は 全体の3割ほどで ここ1年で急増しているといいます",
      "ko": ""
    },
    {
      "s": 137.44,
      "e": 146.44,
      "zh": "発信したことによって減っているので ひとまず安心かなという感じがありますけれども",
      "ko": ""
    },
    {
      "s": 146.44,
      "e": 152.44,
      "zh": "ところが落ち着いたかと思った矢先に 驚きの出来事が",
      "ko": ""
    },
    {
      "s": 153.68,
      "e": 160.72,
      "zh": "Xの方で中国語でコメント もしくは引用リツイートというのが何件かあったんですけれども",
      "ko": ""
    },
    {
      "s": 160.72,
      "e": 166.5,
      "zh": "店のXに中国語での苦情が相次いだのです",
      "ko": ""
    },
    {
      "s": 166.5,
      "e": 169.34,
      "zh": "その内容を見てみると",
      "ko": ""
    },
    {
      "s": 169.34,
      "e": 172.5,
      "zh": "この国は説教好きだね",
      "ko": ""
    },
    {
      "s": 172.5,
      "e": 179.24,
      "zh": "回転率を上げたいなら時間制限を作ればいい といった批判的なものでした",
      "ko": ""
    },
    {
      "s": 179.24,
      "e": 183.18,
      "zh": "イヤホンつけるのは自由だろう",
      "ko": ""
    },
    {
      "s": 183.18,
      "e": 186.5,
      "zh": "じゃあスピーカーにしてやる",
      "ko": ""
    },
    {
      "s": 186.5,
      "e": 190.5,
      "zh": "イヤホンつけるのは失礼かも",
      "ko": ""
    },
    {
      "s": 190.5,
      "e": 194.78,
      "zh": "コメント欄に賛否の声が殺到",
      "ko": ""
    },
    {
      "s": 194.78,
      "e": 197.7,
      "zh": "6000万人以上が閲覧し",
      "ko": ""
    },
    {
      "s": 197.7,
      "e": 200.58,
      "zh": "一時トレンドランキング2位となるなど",
      "ko": ""
    },
    {
      "s": 200.58,
      "e": 204.14,
      "zh": "中国で大きな反響を呼ぶ事態となったのです",
      "ko": ""
    },
    {
      "s": 204.14,
