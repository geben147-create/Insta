    {
      "s": 0.11,
      "e": 1.35,
      "text": "主角是顶替杀手"
    },
    {
      "s": 1.35,
      "e": 4.67,
      "text": "完成任务后去找堂洗澡"
    },
    {
      "s": 4.67,
      "e": 5.73,
      "text": "踩到肥皂摔倒"
    },
    {
      "s": 5.73,
      "e": 6.53,
      "text": "陷入昏迷"
    },
    {
      "s": 6.53,
      "e": 8.65,
      "text": "娜娜把自己的手牌和主角交换"
    },
    {
      "s": 8.65,
      "e": 10.37,
      "text": "貌认了主角的身份和财产"
    },
    {
      "s": 10.37,
      "e": 11.41,
      "text": "主角却失了意"
    },
    {
      "s": 11.41,
      "e": 13.09,
      "text": "过起了娜娜的群演生活"
    },
    {
      "s": 13.09,
      "e": 15.35,
      "text": "却在打戏中有出色的表现"
    },
    {
      "s": 15.35,
      "e": 18.23,
      "text": "名气越来越大"
    },
    {
      "s": 18.23,
      "e": 19.61,
      "text": "突然就恢复了记忆"
    },
    {
      "s": 19.61,
      "e": 20.87,
      "text": "娜娜接到尾托"
    },
    {
      "s": 20.87,
      "e": 22.61,
      "text": "财团要干掉卧底的女主"
    },
    {
      "s": 22.61,
      "e": 24.61,
      "text": "娜娜决定带上前和女主逃走"
    },
    {
      "s": 24.61,
      "e": 25.79,
      "text": "主角找到了二人"
    },
    {
      "s": 25.79,
      "e": 27.29,
      "text": "计划上演夹死戏马"
    },
    {
      "s": 27.29,
      "e": 28.61,
      "text": "在财法的旁观下"
    },
    {
      "s": 28.61,
      "e": 30.03,
      "text": "娜娜拔刀干掉女主"
    },
    {
      "s": 30.03,
      "e": 31.49,
      "text": "主角出场灭口娜娜"
    },
    {
      "s": 31.49,
      "e": 32.67,
      "text": "两人激烈厮杀"
    },
    {
      "s": 32.67,
      "e": 34.41,
      "text": "集装箱掉落砸中两人"
    },
    {
      "s": 34.41,
      "e": 35.71,
      "text": "财法放心离开"
    },
    {
      "s": 35.71,
      "e": 37.37,
      "text": "三人开始重新生活"
    }
