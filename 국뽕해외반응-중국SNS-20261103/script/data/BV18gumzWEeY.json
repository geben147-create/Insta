    {
      "s": 229.82,
      "e": 230.76,
      "text": "思惑があると"
    },
    {
      "s": 230.76,
      "e": 233.22,
      "text": "これをしていくにはやっぱりここをね"
    },
    {
      "s": 233.22,
      "e": 235.06,
      "text": "ちょっと底上げしていかなければならない"
    },
    {
      "s": 235.06,
      "e": 236.08,
      "text": "ということがあるんですけれども"
    },
    {
      "s": 236.08,
      "e": 240.24,
      "text": "これじゃあどうやって解消していこうといいますか"
    },
    {
      "s": 240.24,
      "e": 241.44,
      "text": "目標を立てていくのか"
    },
    {
      "s": 241.44,
      "e": 243.14,
      "text": "鍵はここにありますということなんです"
    },
    {
      "s": 243.14,
      "e": 246.18,
      "text": "欧米の遠方の旅行客ですということで"
    },
    {
      "s": 246.18,
      "e": 249.56,
      "text": "遠方のために支出額が非常に大きくなります"
    },
    {
      "s": 249.56,
      "e": 253.18,
      "text": "1人増えるだけでも影響が大きいんですということで"
    },
    {
      "s": 253.18,
      "e": 256.38,
      "text": "ここに対するどうやってアプローチをしていくかということが"
    },
    {
      "s": 256.38,
      "e": 258.48,
      "text": "今からの鍵になってきますよということなんです"
    },
    {
      "s": 258.48,
      "e": 261.74,
      "text": "じゃあどんなふうな今構成になっているのか"
    },
    {
      "s": 261.74,
      "e": 264.9,
      "text": "外国人のお客さんたちがどうなっているのかといいますと"
    },
    {
      "s": 264.9,
      "e": 269.56,
      "text": "やはりもうすごく東アジアからの方が非常に多いと"
    },
    {
      "s": 269.56,
      "e": 271.88,
      "text": "ただやっぱり専門家の方にお話を伺うと"
    },
    {
      "s": 271.88,
      "e": 275.64,
      "text": "ここの方々は円安であったりとか"
    },
    {
      "s": 275.64,
      "e": 277.98,
      "text": "為替の動向に非常に敏感なので"
    },
    {
      "s": 277.98,
      "e": 281.9,
      "text": "来る来ないがそこによって大きく左右されるということなんですよね"
    },
    {
      "s": 281.9,
      "e": 286.32,
      "text": "一方で欧米ですよねであったりオーストラリア中東の方は"
    },
    {
      "s": 286.32,
      "e": 290.0,
      "text": "もうここに行きましょうと予定してこられるので"
    },
    {
      "s": 290.0,
      "e": 294.48,
      "text": "大きくそのあたり為替であったりとかに左右されないということで"
    },
    {
      "s": 294.48,
      "e": 296.88,
      "text": "これ2019年に比べると実を言いますと"
    },
    {
      "s": 296.88,
      "e": 300.8,
      "text": "3%ほど割合はちょっとなんですけど増えてきているということで"
    },
    {
      "s": 300.8,
      "e": 304.64,
      "text": "ここをどうやってしっかりと確保し"
    },
    {
      "s": 304.64,
      "e": 307.02,
      "text": "さらに拡大するかというところが"
    },
    {
      "s": 307.02,
      "e": 310.76,
      "text": "消費額に大きく影響してくるということなんですけれども"
    },
    {
      "s": 310.76,
      "e": 314.8,
      "text": "やっぱり平均の宿泊数が違いますよね"
    },
    {
      "s": 314.8,
      "e": 316.88,
      "text": "日本人の方から見たらね"
