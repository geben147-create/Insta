  "lines": [
    {
      "s": 0.0,
      "e": 3.72,
      "text": "今日まさに本当に先ほど4時15分に"
    },
    {
      "s": 3.72,
      "e": 9.88,
      "text": "訪日外国人の方の6月のどのくらい来られたのかっていう数字が発表されまして"
    },
    {
      "s": 9.88,
      "e": 12.06,
      "text": "なんと今日発表"
    },
    {
      "s": 12.06,
      "e": 18.1,
      "text": "過去最速で1月から6月までで2000万人突破したということで"
    },
    {
      "s": 18.1,
      "e": 23.9,
      "text": "非常に速いスピードで今外国人観光客の方が来ていらっしゃっていると"
    },
    {
      "s": 23.9,
      "e": 27.72,
      "text": "ちなみになんですけども消費額で言いますと"
    },
    {
      "s": 27.72,
      "e": 32.12,
      "text": "ここも過去最高ということで1月から6月までで言うと"
    },
    {
      "s": 32.12,
      "e": 34.38,
      "text": "過去最高になってきているということで"
    },
    {
      "s": 34.38,
      "e": 40.06,
      "text": "すごく上り上司で来ているというのがここからは伺えるんですけども"
    },
    {
      "s": 40.06,
      "e": 46.2,
      "text": "ただ一方でちょっと落とし穴ちょっと大丈夫だろうかというような数字も出てきているということなんですよね"
    },
    {
      "s": 46.2,
      "e": 47.68,
      "text": "それがこちらになります"
    },
    {
      "s": 47.68,
      "e": 53.16,
      "text": "百貨店の売り上げなんですけどもこれ5月なんですけれども"
    },
    {
      "s": 53.16,
      "e": 60.56,
      "text": "免税品インバウンドに関する売り上げっていうのが40.8%減りましたということなんです"
    },
    {
      "s": 60.56,
      "e": 64.56,
      "text": "でこれそこまでじゃあ悲観的に見なきゃいけないのかというと"
    },
    {
      "s": 64.56,
      "e": 71.5,
      "text": "お話を伺うと2019年と2023年に比べるとそれよりは多いということなので"
    },
    {
      "s": 71.5,
      "e": 73.5,
      "text": "去年がすごく多かったんですそうです"
    },
    {
      "s": 73.5,
      "e": 76.94,
      "text": "円安の影響で爆買いがあったということで"
    },
    {
      "s": 76.94,
      "e": 79.92,
      "text": "それに比べるとちょっと減っているということで"
    },
    {
      "s": 79.92,
      "e": 83.12,
      "text": "このあたりどういうふうに見ていったらいいのかなということを"
    },
    {
      "s": 83.12,
      "e": 84.58,
      "text": "紐解いていきたいと思うんですけども"
    },
    {
      "s": 84.58,
      "e": 90.0,
      "text": "じゃあこの40.8%押し下げたものは何なのかと言いますと"
    },
    {
      "s": 90.0,
      "e": 108.42,
      "text": "中国人観光客の方が"
    },
    {
      "s": 108.42,
      "e": 114.9,
      "text": "2024年でいうと旅行の消費額1兆7265億円"
    },
    {
      "s": 114.9,
      "e": 118.0,
      "text": "本当に多くのところを占めているんですけども"
    },
    {
      "s": 118.0,
      "e": 122.3,
      "text": "この方々の消費動向っていうのがちょっと変わってきているんじゃないか"
    },
    {
      "s": 122.3,
      "e": 123.96,
      "text": "というふうに言われているということなんですよね"
    },
    {
      "s": 123.96,
      "e": 126.44,
      "text": "じゃあどういったところにそれが現れているのか"
    },
    {
      "s": 126.44,
      "e": 128.24,
      "text": "専門家の方にお話を伺いました"
    },
    {
      "s": 128.24,
      "e": 133.76,
      "text": "中国人客の変化に関してはやっぱり経済の減速があります"
    },
    {
      "s": 133.76,
      "e": 136.0,
      "text": "消費マインドが下がっている"
    },
    {
      "s": 136.0,
      "e": 139.32,
      "text": "外国に行こうという方もちょっと減ってきているんじゃないか"
    },
    {
      "s": 139.32,
      "e": 140.4,
      "text": "ということもおっしゃってました"
    },
    {
      "s": 140.4,
      "e": 144.14,
      "text": "で客層の変化ここがやっぱり大きいんですよと"
    },
    {
      "s": 144.14,
      "e": 148.94,
      "text": "富裕層から中間層へ裾野が広がってきていると"
    },
    {
      "s": 148.94,
      "e": 152.78,
      "text": "富裕層の方がリピーターとして何度も来るというよりは"
    },
    {
      "s": 152.78,
      "e": 154.92,
      "text": "中間層の方が来ることによって"
    },
    {
      "s": 154.92,
      "e": 157.78,
      "text": "それでやっぱりお金を落とす額が減ってきているということ"
    },
    {
      "s": 157.78,
      "e": 162.22,
      "text": "でそれも含めてやっぱり売上げの半数以上"
    },
    {
      "s": 162.22,
      "e": 165.14,
      "text": "今日ね大阪の百貨店の方にお話を伺ったんですけど"
    },
    {
      "s": 165.14,
      "e": 168.32,
      "text": "売上げの半数以上がやっぱり中国人の方なんですけども"
    },
    {
      "s": 168.32,
      "e": 172.56,
      "text": "以前よりも高額商品が売れていないということで"
    },
    {
      "s": 172.56,
      "e": 175.0,
      "text": "お客さんの数は増えてきているそうなんです"
    },
    {
      "s": 175.0,
      "e": 178.08,
      "text": "化粧品とかそういったものは売れているけども"
    },
    {
      "s": 178.08,
      "e": 182.32,
      "text": "時計とか宝飾品とかそういったものは売れていないということで"
    },
    {
      "s": 182.32,
      "e": 185.24,
      "text": "ここをどうやって今後対策しているのかというのを"
    },
    {
      "s": 185.24,
      "e": 186.96,
      "text": "いろいろ知恵を絞っていらっしゃる状況ということ"
    },
    {
      "s": 186.96,
      "e": 189.08,
      "text": "インフルエンサーの方をねご呼びして"
    },
    {
      "s": 189.08,
      "e": 190.98,
      "text": "それで旅行前に見ていただく"
    },
    {
      "s": 190.98,
      "e": 192.62,
      "text": "そんな発信をしたりとかっていうことを"
    },
    {
      "s": 192.62,
      "e": 194.96,
      "text": "いろいろ考えていらっしゃるということなんですけども"
    },
    {
      "s": 194.96,
      "e": 196.78,
      "text": "じゃあなんでここが大事なのか"
    },
    {
      "s": 196.78,
      "e": 198.44,
      "text": "そこまで悲観的じゃないにしても"
    },
    {
      "s": 198.44,
      "e": 200.4,
      "text": "なぜここが大事なのかといいますと"
    },
    {
      "s": 200.4,
      "e": 202.6,
      "text": "政府が掲げている目標です"
    },
    {
      "s": 202.6,
      "e": 203.2,
      "text": "こちらです"
    },
    {
      "s": 203.2,
      "e": 205.7,
      "text": "2024年"
    },
    {
      "s": 205.7,
      "e": 209.36,
      "text": "今去年来ていた赤い黒人の方は"
    },
    {
      "s": 209.36,
      "e": 211.82,
      "text": "約3700万人だったんですけれども"
    },
    {
      "s": 211.82,
      "e": 213.74,
      "text": "これを2030年までに"
    },
    {
      "s": 213.74,
      "e": 215.52,
      "text": "6000万人に増やしたいということ"
    },
    {
      "s": 215.52,
      "e": 218.68,
      "text": "やはりそこに消費額ですよね"
    },
    {
      "s": 218.68,
      "e": 221.44,
      "text": "8兆1000億円だったのが15兆円"
    },
    {
      "s": 221.44,
      "e": 224.18,
      "text": "倍ぐらいに増やしていきたいとなった時に"
    },
    {
      "s": 224.18,
      "e": 226.92,
      "text": "やはり人の人数もさることながら"
    },
    {
      "s": 226.92,
      "e": 229.82,
      "text": "消費についてもそこを促進させていきたいという"
