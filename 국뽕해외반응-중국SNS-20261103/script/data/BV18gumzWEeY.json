    },
    {
      "s": 322.04,
      "e": 324.1,
      "text": "中国はやっぱり近いということもあって"
    },
    {
      "s": 324.1,
      "e": 327.3,
      "text": "それでもやっぱり9.2泊ということなので非常に多いんですけど"
    },
    {
      "s": 327.3,
      "e": 329.12,
      "text": "アメリカイギリスになってくると"
    },
    {
      "s": 329.12,
      "e": 332.56,
      "text": "やっぱり2週間に近い日数になってくるとなると"
    },
    {
      "s": 332.56,
      "e": 335.12,
