    {
      "s": 655.1,
      "e": 657.12,
      "text": "这篮球体系当中"
    },
    {
      "s": 657.12,
      "e": 660.48,
      "text": "一定是先具备个人能力"
    },
    {
      "s": 660.48,
      "e": 663.58,
      "text": "再有高水平的团队协助"
