    },
    {
      "s": 206.28,
      "e": 207.9,
      "text": "轻薄垂顺透气不闷"
    },
    {
      "s": 207.9,
      "e": 209.04,
      "text": "贴肤不扎人"
    },
    {
      "s": 209.04,
