    },
    {
      "s": 351.78,
      "e": 353.5,
      "text": "这里的媒体都是垃圾"
    },
    {
      "s": 353.5,
      "e": 354.16,
      "text": "没有客观"
    },
    {
      "s": 354.16,
      "e": 355.6,
      "text": "网友们都在相信他们"
    },
    {
      "s": 355.6,
      "e": 356.84,
      "text": "你就会陷入困境的"
    },
    {
      "s": 356.84,
      "e": 357.66,
      "text": "下一位"
    },
    {
      "s": 357.66,
      "e": 358.82,
      "text": "很多人不知道"
