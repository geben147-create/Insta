    {
      "s": 24.94,
      "e": 27.7,
      "text": "겔폴드와 비슷한 부분이 너무 많아요"
    },
    {
      "s": 27.7,
      "e": 30.7,
      "text": "그럼에도 불구하고 베젤도 좀 두껍고 해서"
    },
    {
      "s": 30.7,
      "e": 34.9,
      "text": "열악판이 아니냐는 얘기를 제가 약간 좀 고급스러운 느낌이 있어요"
    },
    {
      "s": 34.9,
      "e": 37.28,
      "text": "여기 이런 소리도 나고요"
    },
    {
      "s": 37.28,
      "e": 41.7,
      "text": "그리고 위쪽에 이런 식으로 약간 글자의 디자인 처리도 해놨고"
    },
    {
      "s": 41.7,
      "e": 43.78,
      "text": "그리고 박스 열리는 방식도"
    },
    {
      "s": 43.78,
      "e": 48.64,
      "text": "이야 이런 거 이런 게 진짜 별거 아닌데"
    },
    {
      "s": 48.64,
      "e": 52.86,
      "text": "되게 소비자 입장에서는 조금 고급스러운 반가움 그런 게 좀 있죠"
    },
    {
      "s": 52.86,
      "e": 55.76,
      "text": "어쨌든 핸드폰은 여기에 위치해 있고"
    },
    {
      "s": 55.76,
      "e": 57.4,
      "text": "뭐야 너 이거 전체가 빠지는구나"
    },
    {
      "s": 57.4,
      "e": 60.4,
      "text": "여기가 이것만 쏙 빼고"
    },
    {
      "s": 60.4,
      "e": 65.4,
      "text": "이거 뒤에는 뭔가 따로 있는 것 같지는 않고요"
    },
    {
      "s": 65.4,
      "e": 69.66,
      "text": "그리고 안쪽에는 여기 사용설명서 같은 게 들어있겠죠"
    },
    {
      "s": 69.66,
      "e": 73.52,
      "text": "일단 유심 빼는 핀 그리고 뭔가 카드가 예뻐요"
    },
    {
      "s": 73.52,
      "e": 76.32,
      "text": "회색 무광 샌딩 마감이 되어 있고요"
