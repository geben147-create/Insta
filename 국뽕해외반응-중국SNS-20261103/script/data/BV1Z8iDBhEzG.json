  "lines": [
    {
      "s": 0.0,
      "e": 2.06,
      "text": "近日,日本大阪南波一家拉面店"
    },
    {
      "s": 2.06,
      "e": 4.08,
      "text": "以中国游客在店内制造麻烦煤油"
    },
    {
      "s": 4.08,
      "e": 5.58,
      "text": "宣布禁止中国人入内"
    },
    {
      "s": 5.58,
      "e": 7.76,
      "text": "店家声称,外国人制造的麻烦中"
    },
    {
      "s": 7.76,
      "e": 9.76,
      "text": "有90%是中国人造成的"
    },
    {
      "s": 9.76,
      "e": 10.94,
      "text": "随着各国网友的申巴"
    },
    {
      "s": 10.94,
      "e": 13.16,
      "text": "发现这家店长期通过阴阳菜单"
    },
    {
      "s": 13.16,
      "e": 15.48,
      "text": "对外国人实施双重定价宰客行为"
    },
    {
      "s": 15.48,
      "e": 18.58,
      "text": "日本网友发布的该店自助点餐机的照片显示"
    },
    {
      "s": 18.58,
      "e": 21.12,
      "text": "针对外国人的收费标准高出约60%"
    },
    {
      "s": 21.12,
      "e": 22.62,
      "text": "而所谓的中国人闹事"
    },
    {
      "s": 22.62,
      "e": 25.84,
      "text": "真相竟是因为能看懂日文中汉字的中国游客"
    },
    {
      "s": 25.84,
      "e": 27.58,
      "text": "识破了骗局并据理力争"
    },
    {
      "s": 27.58,
      "e": 29.64,
      "text": "这便是店家恼羞成怒的原因"
    }
  ],
  "chapters": []
}