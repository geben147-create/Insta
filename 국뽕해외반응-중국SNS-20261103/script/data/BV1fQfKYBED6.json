    {
      "s": 0.02,
      "e": 3.56,
      "text": "20多万就能开上韩国明星财阀的座驾"
    },
    {
      "s": 3.56,
      "e": 5.3,
      "text": "但这车太小众了"
    },
    {
      "s": 5.3,
      "e": 7.64,
      "text": "估计99%的人都不认识"
    },
    {
      "s": 7.64,
      "e": 10.3,
      "text": "棒组的设计确实太懂年轻了"
    },
    {
      "s": 10.3,
      "e": 12.66,
      "text": "销量差只是因为它太小小小小小"
    },
    {
      "s": 12.66,
      "e": 13.74,
      "text": "小众了"
    },
    {
      "s": 13.74,
      "e": 14.98,
      "text": "抛开国际的话"
    },
    {
      "s": 14.98,
      "e": 17.12,
      "text": "你是不是觉得这个车还蛮帅的"
    },
    {
      "s": 17.12,
      "e": 20.04,
      "text": "还有就是这个车的赛电实在是太少了"
    },
    {
      "s": 20.04,
      "e": 21.38,
      "text": "国内只有19家"
    },
    {
      "s": 21.38,
      "e": 22.48,
      "text": "你要磕了碰了"
    },
    {
      "s": 22.48,
      "e": 23.32,
      "text": "想要保养的话"
    },
    {
      "s": 23.32,
      "e": 24.5,
      "text": "相当费劲"
    },
    {
      "s": 24.5,
      "e": 25.86,
      "text": "至于保值率的话"
    },
    {
      "s": 25.86,
      "e": 27.62,
      "text": "这车你买了就不要想卖了"
    },
    {
      "s": 27.62,
      "e": 28.7,
      "text": "不管是棘手"
    },
    {
      "s": 28.7,
      "e": 30.02,
      "text": "黑心车商只要一出价"
    },
    {
      "s": 30.02,
      "e": 31.5,
      "text": "估计你都得两眼一黑"
    },
    {
      "s": 31.5,
      "e": 33.62,
      "text": "我这台是24年的杰尼赛斯"
    },
    {
      "s": 33.62,
      "e": 35.36,
      "text": "7V70新车没啥优惠"
    },
    {
      "s": 35.36,
      "e": 37.46,
      "text": "我这台才开1800公里"
    },
    {
      "s": 37.46,
      "e": 39.38,
      "text": "足足比新车省了十多万"
    },
    {
      "s": 39.38,
      "e": 40.64,
      "text": "在20多万预算里"
    },
    {
      "s": 40.64,
      "e": 42.98,
      "text": "能给你2.5T 304匹的马力"
    },
    {
      "s": 42.98,
      "e": 44.66,
      "text": "没有车比这台棒子生车"
    },
    {
      "s": 44.66,
      "e": 45.62,
      "text": "性价比更高吧"
    },
    {
      "s": 45.62,
      "e": 46.22,
