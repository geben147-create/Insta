  "lines": [
    {
      "s": 0.0,
      "e": 1.1,
      "text": "全是鸡皮的盒饭"
    },
    {
      "s": 1.1,
      "e": 2.44,
      "text": "满满一盒葱的拌面"
    },
    {
      "s": 2.44,
      "e": 3.66,
      "text": "这些奇葩的吃法"
    },
    {
      "s": 3.66,
      "e": 4.86,
      "text": "却被日本的唐吉赫德"
    },
    {
      "s": 4.86,
      "e": 5.88,
      "text": "直接做成了商品"
    },
    {
      "s": 5.88,
      "e": 7.74,
      "text": "两年卖超31亿日元"
    },
    {
      "s": 7.74,
      "e": 8.86,
      "text": "它就是唐吉赫德"
    },
    {
      "s": 8.86,
      "e": 9.92,
      "text": "推出的熟食品牌"
    },
    {
      "s": 9.92,
      "e": 10.52,
      "text": "偏爱饭"
    },
    {
      "s": 10.52,
      "e": 12.46,
      "text": "为啥这些看起来奇怪的便当"
    },
    {
      "s": 12.46,
      "e": 14.06,
      "text": "能让日本人疯狂买单呢"
    },
    {
      "s": 14.06,
      "e": 15.74,
      "text": "偏爱饭诞生之前"
    },
    {
      "s": 15.74,
      "e": 17.38,
      "text": "唐吉赫德和大多便利店一样"
    },
    {
      "s": 17.38,
      "e": 18.86,
      "text": "把便当菜品做得稳一点"
    },
    {
      "s": 18.86,
      "e": 19.84,
      "text": "搭配正常一点"
    },
    {
      "s": 19.84,
      "e": 21.62,
      "text": "尽可能照顾更多人的口味"
    },
    {
      "s": 21.62,
      "e": 23.12,
      "text": "产品是没什么缺点了"
    },
    {
      "s": 23.12,
      "e": 24.28,
      "text": "但销量却一直都不行"
    },
    {
      "s": 24.28,
      "e": 25.48,
      "text": "因为很多人吃完"
    },
    {
      "s": 25.48,
      "e": 25.96,
      "text": "只会觉得"
    },
    {
      "s": 25.96,
      "e": 27.24,
      "text": "不难吃也不好吃"
    },
    {
      "s": 27.24,
      "e": 28.14,
      "text": "60分刚好"
    },
    {
      "s": 28.14,
      "e": 29.86,
      "text": "可60分的商品太多了"
    },
    {
      "s": 29.86,
      "e": 31.02,
      "text": "我为什么非要买你呢"
    },
    {
      "s": 31.02,
      "e": 32.44,
      "text": "这让唐吉赫德意识到"
    },
    {
      "s": 32.44,
      "e": 33.2,
      "text": "与其做一款"
    },
    {
      "s": 33.2,
      "e": 34.78,
      "text": "大多数人都说还可以的饭"
    },
    {
      "s": 34.78,
      "e": 36.5,
      "text": "不如做一些特殊偏好的饭"
    },
    {
      "s": 36.5,
      "e": 37.64,
      "text": "而最先卖火的"
    },
    {
      "s": 37.64,
      "e": 38.64,
      "text": "就是鸡皮便当"
    },
    {
      "s": 38.64,
      "e": 40.48,
      "text": "灵感来自团队内部的一位员工"
    },
    {
      "s": 40.48,
      "e": 41.44,
      "text": "他每次吃炸鸡"
    },
    {
      "s": 41.44,
      "e": 43.04,
      "text": "都会把皮包下来单独吃"
    },
    {
      "s": 43.04,
      "e": 45.06,
      "text": "有一次甚至把家里炸鸡的皮"
    },
    {
      "s": 45.06,
      "e": 45.94,
      "text": "全都吃光了"
    },
    {
      "s": 45.94,
      "e": 47.18,
      "text": "只留下没皮的鸡肉"
    },
    {
      "s": 47.18,
      "e": 48.36,
      "text": "还被气死骂了一顿"
    },
    {
      "s": 48.36,
      "e": 50.06,
      "text": "这个看似奇怪的习惯"
    },
    {
      "s": 50.06,
      "e": 51.14,
      "text": "却让团队意识到"
    },
    {
      "s": 51.14,
      "e": 52.22,
      "text": "既然有人爱这么吃"
    },
    {
      "s": 52.22,
      "e": 53.7,
      "text": "为什么不能直接卖给他呢"
    },
    {
      "s": 53.7,
      "e": 55.3,
      "text": "于是一份只有炸鸡的皮"
    },
    {
      "s": 55.3,
      "e": 57.04,
      "text": "和白米饭的便当就诞生了"
    },
    {
      "s": 57.04,
      "e": 58.1,
      "text": "对普通人来说"
    },
    {
      "s": 58.1,
      "e": 58.92,
      "text": "它可能很离谱"
    },
    {
      "s": 58.92,
      "e": 60.54,
      "text": "但对超爱鸡皮的人来说"
    },
    {
      "s": 60.54,
      "e": 61.24,
      "text": "就有了一种"
    },
    {
      "s": 61.24,
      "e": 62.44,
      "text": "终于有人懂我的感觉"
    },
    {
      "s": 62.44,
      "e": 63.7,
      "text": "不仅是自己会复购"
    },
    {
      "s": 63.7,
      "e": 65.02,
      "text": "还会主动推荐给身边"
    },
    {
      "s": 65.02,
      "e": 65.86,
      "text": "同样爱吃的人"
    },
    {
      "s": 65.86,
      "e": 67.22,
      "text": "偏爱饭卖火的原因"
    },
    {
      "s": 67.22,
      "e": 67.96,
      "text": "也正在这里"
    },
    {
      "s": 67.96,
      "e": 69.3,
      "text": "有人吃面就想吃葱"
    },
    {
      "s": 69.3,
      "e": 70.26,
      "text": "唐吉赫德就推出"
    },
    {
      "s": 70.26,
      "e": 71.48,
      "text": "一整碗葱花乌冬面"
    },
    {
      "s": 71.48,
      "e": 73.22,
      "text": "有人嫌三明治里的蛋太少"
    },
    {
      "s": 73.22,
      "e": 75.52,
      "text": "他就推出有2.5颗糖心蛋的三明治"
    },
    {
      "s": 75.52,
      "e": 76.86,
      "text": "还意外吸引了不少"
    },
    {
      "s": 76.86,
      "e": 79.08,
      "text": "需要补充蛋白质的健身人群购买"
    },
    {
      "s": 79.08,
      "e": 80.84,
      "text": "于是唐吉赫德开始疯狂整活"
    },
    {
      "s": 80.84,
      "e": 82.02,
      "text": "但他很快就发现"
    },
    {
      "s": 82.02,
      "e": 83.76,
      "text": "小众猎奇很容易制造话题"
    },
    {
      "s": 83.76,
      "e": 85.7,
      "text": "真正有人爱吃却很难验证"
    },
    {
      "s": 85.7,
      "e": 87.24,
      "text": "所以截至到今年6月"
    },
    {
      "s": 87.24,
      "e": 89.08,
      "text": "团队共提了454个创意"
    },
    {
      "s": 89.08,
      "e": 91.46,
      "text": "但做成商品上市的只有118个"
    },
    {
      "s": 91.46,
      "e": 93.38,
      "text": "采用率只有26%"
    },
    {
      "s": 93.38,
      "e": 95.2,
      "text": "他们甚至试过香菜塞满的三明治"
    },
    {
      "s": 95.2,
      "e": 97.56,
      "text": "可真拿给香菜重度爱好者试吃后"
    },
    {
      "s": 97.56,
      "e": 99.0,
      "text": "对方却觉得香菜味不够"
    },
    {
      "s": 99.0,
      "e": 101.36,
      "text": "这让唐吉赫德终于摸清了一个边界"
    },
    {
      "s": 101.36,
      "e": 103.88,
      "text": "偏爱饭不能只是把某种食材多放一点"
    },
    {
      "s": 103.88,
      "e": 105.1,
      "text": "再取个夸张的名字"
    },
    {
      "s": 106.86,
      "e": 108.94,
      "text": "真正喜欢他的人吃完还想买"
    },
    {
      "s": 108.94,
      "e": 110.2,
      "text": "唐吉赫德卖的不是便当"
