  "verdict": "",
  "lines": [
    {
      "s": 0.0,
      "e": 1.78,
      "text": "当韩国的小学生遇上顶级女团"
    },
    {
      "s": 1.78,
      "e": 3.28,
      "text": "双方都会有怎样的反应呢"
    },
    {
      "s": 3.28,
      "e": 9.2,
      "text": "今天节目组特邀来来挨女团"
    },
    {
      "s": 9.2,
      "e": 11.64,
      "text": "让她们和一群小学生们来一场不眨眼大挑战"
    },
    {
      "s": 11.64,
      "e": 13.38,
      "text": "第一位出场的是女团队长安佑珍"
    },
    {
      "s": 13.38,
      "e": 14.76,
      "text": "而对手是可爱的学霸姐"
    },
    {
      "s": 14.76,
      "e": 16.9,
      "text": "只见佑珍略微转头一个甜蜜的微笑"
    },
    {
      "s": 16.9,
      "e": 18.68,
      "text": "瞬间就让对手输得一塌糊涂"
    },
    {
      "s": 18.68,
      "e": 22.58,
      "text": "原来学霸姐第一眼就认出了咱佑珍"
    },
    {
      "s": 22.58,
      "e": 24.74,
      "text": "爱豆的一个平A镜直接让对手交了大招"
    },
    {
      "s": 24.74,
      "e": 26.9,
      "text": "这真是刚出新手村就遇到满级大佬啊"
    },
    {
      "s": 26.9,
      "e": 29.06,
      "text": "第二位登场的是女团的颜值担当张圆英"
    },
    {
      "s": 29.06,
      "e": 30.94,
      "text": "她的对手是一名12岁的小孩姐"
    },
    {
      "s": 30.94,
      "e": 38.26,
      "text": "双方刚开始都显得很实淡定"
    },
    {
      "s": 38.26,
      "e": 40.7,
      "text": "但女孩这自信的眼神加上着微微上扬的嘴角"
    },
    {
      "s": 40.7,
      "e": 42.36,
      "text": "彻底把咱圆英都笑了"
    },
    {
      "s": 42.36,
      "e": 46.05,
      "text": "女孩依附实在必得的表情"
    },
    {
      "s": 46.05,
      "e": 47.65,
      "text": "多少让圆英感受到了一些压力"
    },
    {
      "s": 47.65,
      "e": 50.19,
      "text": "试图通过语言干扰来转移小孩姐的注意力"
    },
    {
      "s": 50.19,
      "e": 55.42,
      "text": "可惜女孩早就看透了她的战术"
    },
    {
      "s": 55.42,
      "e": 57.6,
      "text": "最终圆英不敌对手主动放弃了比赛"
    },
    {
      "s": 57.6,
      "e": 63.9,
      "text": "没想到小女孩的胜负欲如此的强大"
    },
    {
      "s": 63.9,
      "e": 65.42,
      "text": "就连咱圆英都抵挡不住"
    },
    {
      "s": 65.42,
      "e": 66.92,
      "text": "紧接着第三位登场的是"
    },
    {
      "s": 66.92,
      "e": 68.34,
      "text": "女团中的顶级魅魔金之源"
    },
    {
      "s": 68.34,
      "e": 70.64,
      "text": "她的对手是眼前这位14岁的淡定哥"
    },
    {
      "s": 70.64,
      "e": 80.46,
      "text": "之源只是一个微笑"
    },
    {
      "s": 80.46,
      "e": 82.3,
      "text": "男孩仅坚持了3秒便败下阵来"
    },
    {
      "s": 82.3,
      "e": 84.06,
      "text": "妹子以为是偶像光环在发力"
    },
    {
      "s": 84.06,
      "e": 86.52,
      "text": "可男孩的回答彻底让咱之源绷不住了"
    },
    {
      "s": 86.52,
      "e": 95.16,
      "text": "好家伙"
    },
    {
      "s": 95.16,
      "e": 96.76,
      "text": "财阀家出身的孩子就是不一样"
    },
    {
      "s": 96.76,
      "e": 97.64,
      "text": "管你好不好看"
    },
    {
      "s": 97.64,
      "e": 98.46,
      "text": "咱就是不认识你"
    },
    {
      "s": 98.46,
      "e": 100.2,
      "text": "多少有些尴尬的Liz介绍起了自己"
    },
    {
      "s": 100.2,
      "e": 102.08,
      "text": "甚至把成员们名字都念了一遍"
    },
    {
      "s": 102.08,
      "e": 103.56,
      "text": "但男孩这一脸猛逼的表情"
    },
    {
      "s": 103.56,
      "e": 104.54,
      "text": "却让Liz被感失落"
    },
    {
      "s": 104.54,
      "e": 116.83,
      "text": "接下来有可爱妹子直景莲"
    },
    {
      "s": 116.83,
      "e": 118.13,
      "text": "对战网红RAP小胖"
    },
    {
      "s": 118.13,
      "e": 123.28,
      "text": "眼神交汇的瞬间"
    },
    {
      "s": 123.28,
      "e": 124.72,
      "text": "小男孩就彻底沦陷了"
    },
    {
      "s": 124.72,
      "e": 125.86,
      "text": "本来还想再挣扎一下"
    },
    {
      "s": 125.86,
      "e": 127.58,
      "text": "却没想到直景莲竟是她的粉丝"
    },
    {
      "s": 127.58,
      "e": 128.36,
      "text": "这意外之喜"
    },
    {
      "s": 128.36,
      "e": 129.62,
      "text": "让男孩激动的语无伦次"
    },
    {
      "s": 129.62,
      "e": 130.5,
      "text": "不争气的眼睛"
    },
    {
      "s": 130.5,
      "e": 131.7,
      "text": "竟情不自禁地眨了一下"
    },
    {
      "s": 131.7,
      "e": 141.94,
      "text": "在这一刻"
    },
    {
      "s": 141.94,
      "e": 143.12,
      "text": "输赢已经不重要了"
    },
    {
      "s": 143.12,
      "e": 143.92,
      "text": "不过咱就是说"
    },
    {
      "s": 143.92,
      "e": 144.92,
      "text": "两人长得也太像了"
    },
    {
      "s": 144.92,
      "e": 146.2,
      "text": "确定他俩不是姐弟吗"
    }
  ],
