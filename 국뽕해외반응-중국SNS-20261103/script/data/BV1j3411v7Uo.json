  "lines": [
    {
      "s": 0.0,
      "e": 2.34,
      "text": "韩国媒体又开始造谣泼脏水了"
    },
    {
      "s": 2.34,
      "e": 23.04,
      "text": "相信看到这儿"
    },
    {
      "s": 23.04,
      "e": 24.22,
      "text": "很多人都有疑问"
    },
    {
      "s": 24.22,
      "e": 26.32,
      "text": "连是宗大芒是谁都不知道"
    },
    {
      "s": 26.32,
      "e": 28.72,
      "text": "又怎么会认为他是中国人呢"
    },
    {
      "s": 28.72,
      "e": 32.48,
      "text": "首先来说说是宗大芒是谁"
    },
    {
      "s": 32.48,
      "e": 35.24,
      "text": "他就是韩国人最尊崇的伟人之一"
    },
    {
      "s": 35.24,
      "e": 36.82,
      "text": "就是他创造了韩文"
    },
    {
      "s": 36.82,
      "e": 38.58,
      "text": "朝鲜一直通用汉字"
    },
    {
      "s": 38.58,
      "e": 41.06,
      "text": "但是汉字系统和韩语不能相通"
    },
    {
      "s": 41.06,
      "e": 42.62,
      "text": "且汉字过于复杂"
    },
    {
      "s": 42.62,
      "e": 45.48,
      "text": "韩文的发明有助于朝鲜半岛扫盲"
    },
    {
      "s": 45.48,
      "e": 48.14,
      "text": "所以韩国人非常尊敬是宗大芒"
    },
    {
      "s": 48.14,
      "e": 50.2,
      "text": "甚至还把他印在了韩帝上"
    },
    {
      "s": 50.2,
      "e": 52.46,
      "text": "所以他的籍贯毫无疑问是韩国"
    },
    {
      "s": 52.46,
      "e": 53.18,
      "text": "朝鲜"
    },
    {
      "s": 53.18,
      "e": 54.94,
      "text": "不知道韩没所谓的我们"
    },
    {
      "s": 54.94,
      "e": 57.36,
      "text": "抢是宗大芒是哪儿看的假消息"
    },
    {
      "s": 57.36,
      "e": 59.84,
      "text": "先不说90%以上的中国人"
    },
    {
      "s": 59.84,
      "e": 61.08,
      "text": "不知道他是谁"
    },
    {
      "s": 61.08,
      "e": 62.96,
      "text": "而且中国的百对百科也说"
    },
    {
      "s": 62.96,
      "e": 64.56,
      "text": "他是朝鲜南朝的人"
    },
    {
      "s": 64.56,
      "e": 66.8,
      "text": "韩媒这又是在炒作心热度吧"
    },
    {
      "s": 66.8,
      "e": 68.44,
      "text": "此时又传到中国"
    },
    {
      "s": 68.44,
      "e": 70.98,
      "text": "来看看中国网友有什么反应吧"
    },
    {
      "s": 70.98,
      "e": 113.41,
      "text": "跟谁稀罕你一样"
    }
  ],
