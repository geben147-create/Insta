    {
      "s": 285.54,
      "e": 288.3,
      "text": "既使用三星SK海力士存储芯片"
    },
    {
      "s": 288.3,
      "e": 290.06,
      "text": "也使用日本凯霞的产品"
    },
    {
      "s": 290.06,
