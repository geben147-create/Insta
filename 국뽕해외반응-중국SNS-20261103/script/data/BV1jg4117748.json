    },
    {
      "s": 84.42,
      "e": 87.3,
      "zh": "韩国食堂在20号正式运营了",
      "ko": ""
    },
    {
      "s": 87.3,
      "e": 89.9,
      "zh": "每天往奥运村送三次便当",
      "ko": ""
    },
    {
      "s": 89.9,
      "e": 91.68,
      "zh": "每天平均送425份",
      "ko": ""
    },
    {
      "s": 91.68,
      "e": 95.08,
      "zh": "我朋友小心疫情之前在韩国站做记者",
      "ko": ""
    },
    {
      "s": 95.08,
      "e": 96.5,
      "zh": "我朋友是这么说的",
      "ko": ""
    },
    {
      "s": 96.5,
      "e": 100.42,
      "zh": "韩国大韩体育会有关工作人员告诉我说",
