  "lines": [
    {
      "s": 0.02,
      "e": 3.76,
      "text": "주춤했던 전기차 시장이 모처럼 활기를 띄고 있습니다."
    },
    {
      "s": 4.1,
      "e": 8.54,
      "text": "고유가 여파로 판매가 늘면서 신차 출시도 속도를 내는 모습인데요."
    },
    {
      "s": 9.12,
      "e": 13.56,
      "text": "막강한 가성비를 앞세운 중국산 전기차가 매섭게 파고들고 있습니다."
    },
    {
      "s": 13.98,
      "e": 14.94,
      "text": "박재현 기자입니다."
    },
    {
      "s": 17.96,
      "e": 20.12,
      "text": "무대에 등장하는 거대한 실루엣."
    },
    {
      "s": 20.3,
      "e": 24.32,
      "text": "현대자동차 제네시스의 첫 초대형 SUV, GV90입니다."
    },
    {
      "s": 25.12,
      "e": 28.74,
      "text": "내연, 하이브리드 모델 없이 순수 전기차로 출시됐습니다."
    },
    {
      "s": 28.74,
      "e": 32.42,
      "text": "국내 제조사 최초로 문이 마주보며 열리고"
    },
    {
      "s": 32.42,
      "e": 36.74,
      "text": "문만 열어도 시동이 걸리는 새로운 기술들이 적용됐습니다."
    },
    {
      "s": 48.5,
      "e": 53.5,
      "text": "최근 현대차 그룹은 스타리아 일렉트리, PV5 등 화물 전기차,"
    },
    {
      "s": 53.5,
      "e": 58.2,
      "text": "아이오닉3, EV2 같은 소형 전기차까지 잇따라 내놓으며"
    },
    {
      "s": 58.2,
      "e": 60.36,
      "text": "전기차 제품군을 넓히고 있습니다."
    },
    {
      "s": 61.4,
      "e": 64.58,
      "text": "대중화를 앞두고 겪는 수요 정체 현상, 이른바 캐짐으로"
    },
    {
      "s": 64.58,
      "e": 68.62,
      "text": "한동안 부진했던 전기차 시장이 최근 살아나고 있기 때문입니다."
    },
    {
      "s": 69.6,
      "e": 73.4,
      "text": "올해 상반기 유럽 전기차 판매량은 122만 8,900여 대로"
    },
    {
      "s": 73.4,
      "e": 76.56,
      "text": "지난해 같은 기간보다 40% 늘었습니다."
    },
    {
      "s": 77.5,
      "e": 81.16,
      "text": "우리나라에서도 같은 기간 판매량이 112% 급증하며"
    },
    {
      "s": 81.16,
      "e": 84.32,
      "text": "누적 등록 대수가 처음으로 100만 대를 돌파했습니다."
    },
    {
      "s": 84.32,
      "e": 88.28,
      "text": "초고유가로 인해서 유가 부담이 되다 보니까"
    },
    {
      "s": 88.28,
      "e": 90.14,
      "text": "전기차에 대한 관심이 커졌고"
    },
    {
      "s": 90.14,
      "e": 93.24,
      "text": "차종에 있어서도 가성비 전기차뿐만이 아니라"
    },
    {
      "s": 93.24,
      "e": 95.88,
      "text": "프리미엄에 이득이까지 다양성이 커지면서"
    },
    {
      "s": 95.88,
      "e": 99.54,
      "text": "다만 시장이 커지는 만큼 가성비를 앞세운"
    },
    {
      "s": 99.54,
      "e": 101.72,
      "text": "중국 전기차의 돌풍이 거셉니다."
    },
    {
      "s": 102.48,
      "e": 104.04,
      "text": "관세 장벽이 낮은 한국에선"
    },
    {
      "s": 104.04,
      "e": 106.86,
      "text": "중국차 경쟁력이 특히 높을 수밖에 없습니다."
    },
    {
      "s": 106.86,
      "e": 111.74,
      "text": "중국 지리자동차 계열 볼보가 중국에서 생산한 최고급 전기차"
    },
    {
      "s": 111.74,
      "e": 115.4,
      "text": "ES90에 국내 시작 판매가는 약 7,300만 원"
    },
    {
      "s": 115.4,
      "e": 120.16,
      "text": "유럽보다 낮은 관세 탓에 볼보에 본사가 있는 스웨덴 판매 가격보다"
    },
    {
      "s": 120.16,
      "e": 121.92,
      "text": "5천만 원 넘게 저렴합니다."
    },
    {
      "s": 123.0,
      "e": 126.02,
      "text": "그렇다 보니 올해 상반기 중국 전기차 판매량은"
    },
    {
      "s": 126.02,
      "e": 128.28,
      "text": "334% 폭증했습니다."
    },
    {
      "s": 129.16,
      "e": 131.28,
      "text": "각국 정부들의 무역 산업 정책까지"
    },
    {
      "s": 131.28,
      "e": 133.82,
      "text": "전기차 시장에 큰 영향을 미치는 상황에서"
    },
    {
      "s": 133.82,
      "e": 138.06,
      "text": "적기에 대응하지 못하면 자칫 주도권을 내줄 수 있다는 우려가 나옵니다."
    },
    {
      "s": 138.06,
