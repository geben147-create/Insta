    {
      "s": 1.96,
      "e": 6.36,
      "zh": "网友杜某在社交平台上发布了一条日本地铁小孩的动态",
      "ko": ""
    },
    {
      "s": 6.36,
      "e": 9.66,
      "zh": "孩子母亲发文辟谣 我家孩子是中国人",
      "ko": ""
    },
    {
      "s": 9.66,
      "e": 11.9,
      "zh": "12月30日 据杭州日报报道",
      "ko": ""
    },
    {
      "s": 11.9,
      "e": 15.1,
      "zh": "近日杭州互联网法院对该案作出判决",
      "ko": ""
    },
    {
      "s": 15.1,
      "e": 17.2,
      "zh": "则令杜某登报赔礼道歉",
      "ko": ""
    },
    {
      "s": 17.2,
      "e": 19.58,
      "zh": "黑场原告精神抚慰金1万元",
      "ko": ""
    },
    {
      "s": 19.58,
      "e": 21.6,
      "zh": "维权费用损失5000元",
      "ko": ""
    },
    {
      "s": 21.6,
      "e": 24.9,
      "zh": "杜某此前发布的照片中的小女孩名叫小楼",
      "ko": ""
    },
    {
      "s": 24.9,
      "e": 27.68,
      "zh": "照片中的小楼非常可爱 扶着把手",
      "ko": ""
    },
    {
      "s": 27.68,
      "e": 31.16,
      "zh": "杜某配文 日本地铁上的小乘客一个人上学",
      "ko": ""
    },
    {
      "s": 31.16,
      "e": 34.42,
      "zh": "那眼神里充满自信和勇气 太可爱了",
      "ko": ""
    },
    {
      "s": 34.42,
      "e": 37.24,
      "zh": "网友们纷纷在该条动态下留言指正",
      "ko": ""
    },
    {
      "s": 37.24,
      "e": 40.54,
      "zh": "但杜某仍拒不更正且不断发布留言回应",
      "ko": ""
    },
    {
      "s": 40.54,
      "e": 43.16,
      "zh": "有网友到小楼母亲的账号下留言告知",
      "ko": ""
    },
    {
      "s": 43.16,
      "e": 46.32,
      "zh": "随后 小楼母亲在不同平台发文澄清",
      "ko": ""
    },
    {
      "s": 46.32,
      "e": 49.68,
      "zh": "小楼母亲称 我家孩子是我大中华儿女",
      "ko": ""
    },
    {
      "s": 49.68,
      "e": 51.48,
      "zh": "并深深爱着我们的祖国",
      "ko": ""
    },
    {
      "s": 51.48,
      "e": 54.28,
      "zh": "请那些擅自乱家文案的人闭嘴",
      "ko": ""
    },
    {
      "s": 54.28,
      "e": 57.98,
      "zh": "小楼及其家人认为杜某的行为侵害小楼肖像权",
      "ko": ""
    },
    {
      "s": 57.98,
      "e": 60.78,
      "zh": "法院认为杜某发布的涉案动态中",
      "ko": ""
    },
    {
      "s": 60.78,
      "e": 63.94,
      "zh": "使用的图片 还有女孩的清晰面部特征",
      "ko": ""
    },
    {
      "s": 63.94,
      "e": 68.54,
      "zh": "体貌状态等 通过比对原告提交证据中小楼本人的肖像",
      "ko": ""
    },
    {
      "s": 68.54,
      "e": 70.56,
      "zh": "以社会一般人的认知标准",
      "ko": ""
    },
    {
      "s": 70.56,
      "e": 73.7,
      "zh": "能够清楚地确认涉案动态图片中的肖像",
      "ko": ""
    },
    {
      "s": 73.7,
      "e": 77.82,
      "zh": "为小楼的形象 故原告小楼对该图片在线的肖像",
      "ko": ""
    },
    {
      "s": 77.82,
      "e": 81.5,
      "zh": "享有肖像权 杜某涉案行为侵害了小楼的肖像权",
