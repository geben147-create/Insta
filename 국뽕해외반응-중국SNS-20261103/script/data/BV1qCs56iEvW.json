    {
      "s": 221.4,
      "e": 223.12,
      "text": "尤其以法国为代表"
    },
    {
      "s": 223.12,
      "e": 225.3,
      "text": "但经历第二次世界大战后"
    },
    {
      "s": 225.3,
      "e": 227.12,
