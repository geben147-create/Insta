    {
      "s": 203.2,
      "e": 204.7,
      "text": "从传统上看"
    },
    {
      "s": 204.7,
      "e": 207.2,
      "text": "包括加拿大在内的北约国家"
    },
    {
      "s": 207.2,
      "e": 209.96,
      "text": "在这方面并没有特别突出的表现"
    },
    {
      "s": 209.96,
      "e": 212.24,
      "text": "现在欧洲有各种示威活动"
    },
    {
      "s": 212.24,
      "e": 214.12,
      "text": "甚至有人投掷燃烧瓶"
    },
    {
      "s": 214.12,
      "e": 216.5,
      "text": "时事评论员谈到这些活动时"
    },
    {
      "s": 216.5,
      "e": 218.48,
      "text": "背后其实涉及很多问题"
    },
    {
      "s": 218.48,
      "e": 221.4,
      "text": "那些国家曾经是拥有殖民地的国家"
