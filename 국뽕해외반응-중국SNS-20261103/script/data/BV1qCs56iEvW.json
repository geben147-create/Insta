    {
      "s": 298.38,
      "e": 300.74,
      "text": "从伊拉克战争到阿富汗战争"
    },
    {
      "s": 300.74,
      "e": 302.3,
      "text": "他们对此感到厌烦"
    },
    {
      "s": 302.3,
      "e": 304.22,
      "text": "所以现在在安全问题上"
    },
    {
      "s": 304.22,
      "e": 305.34,
      "text": "不愿再听美国的"
    },
    {
      "s": 305.34,
      "e": 307.28,
      "text": "想按照自己的方式行事"
    },
    {
      "s": 307.28,
      "e": 309.08,
      "text": "你刚才提到了潜艇问题"
