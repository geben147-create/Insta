    },
    {
      "s": 240.74,
      "e": 242.5,
      "text": "俄乌战争仍在继续"
    },
    {
      "s": 242.5,
      "e": 244.84,
      "text": "伊朗和中东局势也在发展"
    },
    {
      "s": 244.84,
      "e": 246.46,
      "text": "但大家关注的焦点"
