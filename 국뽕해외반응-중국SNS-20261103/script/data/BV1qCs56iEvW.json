    {
      "s": 272.46,
      "e": 275.3,
      "text": "中国正在成为一个军事强国"
    },
    {
      "s": 275.3,
      "e": 277.88,
      "text": "尤其是在太平洋地区那些讲英语的"
    },
    {
      "s": 277.88,
      "e": 279.42,
      "text": "昂格鲁撒克逊国家中"
    },
    {
      "s": 279.42,
      "e": 280.9,
      "text": "以目前的情况来看"
    },
    {
      "s": 280.9,
      "e": 283.04,
      "text": "加拿大比澳大利亚更加懈怠"
    },
    {
      "s": 283.04,
      "e": 286.1,
      "text": "特朗普只是把长期积累的问题说了出来"
    },
    {
      "s": 286.1,
      "e": 288.62,
      "text": "我并不是在表达亲特朗普立场"
    },
    {
      "s": 288.62,
      "e": 291.08,
      "text": "而是说这些国家在国防政策上"
    },
    {
      "s": 291.08,
      "e": 292.26,
      "text": "总是看别人脸色"
    },
    {
      "s": 292.26,
      "e": 293.82,
      "text": "行动迟缓"
    },
    {
      "s": 293.82,
      "e": 295.52,
      "text": "当然从他们的角度来说"
    },
    {
      "s": 295.52,
      "e": 297.08,
      "text": "过去在反恐战争期间"
    },
    {
      "s": 297.08,
      "e": 298.38,
      "text": "一直被美国牵着走"
