    {
      "s": 0.22,
      "e": 1.44,
      "text": "大家好,我是张北海"
    },
    {
      "s": 1.44,
      "e": 2.96,
      "text": "2023年开年以来"
    },
    {
      "s": 2.96,
      "e": 4.56,
      "text": "中国票房已67亿"
    },
    {
      "s": 4.56,
      "e": 5.54,
      "text": "暂居全球第一"
    },
    {
      "s": 5.54,
      "e": 6.86,
      "text": "排第二的是北美"
    },
    {
      "s": 6.86,
      "e": 7.82,
      "text": "第三是韩国"
    },
    {
      "s": 7.82,
      "e": 8.86,
      "text": "第四德国"
    },
    {
      "s": 8.86,
      "e": 10.92,
      "text": "韩国媒体对此事进行了报道"
    },
    {
      "s": 10.92,
      "e": 13.56,
      "text": "并称韩国影视业这几年发展十道迅猛"
    },
    {
      "s": 13.56,
      "e": 14.9,
      "text": "积极开阔国际市场"
    },
    {
      "s": 14.9,
      "e": 18.12,
      "text": "知名演员马东西甚至还加入了漫威演员阵容"
    },
    {
      "s": 18.12,
      "e": 19.82,
      "text": "韩国上下也是大家赞赏"
    },
    {
      "s": 19.82,
      "e": 24.06,
      "text": "那么中国电影票房的市场能否成为韩国电影界发展的机遇"
    },
    {
      "s": 24.06,
      "e": 26.38,
      "text": "视频做了一个大大的疑问"
    },
    {
      "s": 26.38,
      "e": 30.64,
      "text": "以下来看看韩国网友们对中国电影票房世界第一的评论吧"
    },
    {
      "s": 30.64,
      "e": 33.3,
      "text": "有喜欢更多相关资讯的请点个三连"
    },
    {
      "s": 33.3,
      "e": 34.28,
      "text": "感谢收看"
    },
    {
      "s": 34.28,
      "e": 37.74,
      "text": "如果厮守人民币"
    },
    {
      "s": 37.74,
      "e": 39.88,
      "text": "最终将失去韩国精神"
    },
    {
      "s": 39.88,
      "e": 41.64,
      "text": "失去民族尊严"
    },
    {
      "s": 41.64,
      "e": 42.62,
      "text": "别担心中国"
    },
    {
      "s": 42.62,
      "e": 44.02,
      "text": "做好我们的就好"
    },
    {
      "s": 44.02,
      "e": 47.44,
      "text": "中国内需之可怕"
    },
    {
      "s": 47.44,
      "e": 49.92,
      "text": "一个可以成为世界第一的市场"
    },
    {
      "s": 49.92,
      "e": 53.52,
      "text": "中国电影市场是甜"
    },
    {
      "s": 53.52,
      "e": 55.22,
      "text": "但市场太大了"
    },
    {
      "s": 55.22,
      "e": 56.34,
      "text": "如果能上映"
    },
    {
      "s": 56.34,
      "e": 58.88,
      "text": "就算是天文数字的收益也不是梦"
    },
    {
      "s": 58.88,
      "e": 59.84,
      "text": "但问题是"
    },
    {
      "s": 59.84,
      "e": 61.78,
      "text": "能上映的电影极其有限"
    },
    {
      "s": 61.78,
      "e": 62.3,
      "text": "首先"
    },
    {
      "s": 62.3,
      "e": 65.08,
      "text": "内容本身必须符合中国的口味"
    },
    {
      "s": 65.08,
      "e": 66.96,
      "text": "而无论电影内容如何"
    },
    {
      "s": 66.96,
      "e": 70.02,
      "text": "往往因为国家间的原因无法上映"
    },
    {
      "s": 70.02,
      "e": 70.66,
      "text": "相反"
    },
    {
      "s": 70.66,
      "e": 73.94,
      "text": "有不少电影在为中国市场拍电影时失败"
    },
    {
      "s": 73.94,
      "e": 79.34,
      "text": "我被张艺谋导演的电影人生深深打动了"
    },
    {
      "s": 79.34,
      "e": 82.29,
      "text": "销售额很高"
    },
    {
      "s": 82.29,
      "e": 83.97,
      "text": "他们应该撒了免费跳哈哈"
    },
    {
      "s": 83.97,
      "e": 88.63,
      "text": "中国人会在影院看韩国电影"
    },
    {
      "s": 88.63,
      "e": 91.17,
      "text": "加载然后去别人毕业上看不就行了"
    },
    {
      "s": 91.17,
      "e": 92.13,
      "text": "你傻吗"
    },
    {
      "s": 92.13,
      "e": 96.96,
      "text": "现在不要指望韩国经济会影响中国"
    },
    {
      "s": 96.96,
      "e": 102.12,
      "text": "中国人只是下载Netway看韩国电影和电视剧"
    },
    {
      "s": 102.12,
      "e": 106.14,
      "text": "为什么他们会花钱在院线上映看韩国电影"
