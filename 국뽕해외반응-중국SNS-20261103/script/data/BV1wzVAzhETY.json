: ""}, {"s": 992036, "e": 993869, "zh": "周边那几个都下班了", "ko": "주변 건물들은 다 퇴근했어", "t": "", "vs": ""}, {"s": 993869, "e": 994480, "zh": "八点钟。", "ko": "8시야", "t": "", "vs": ""}, {"s": 994960, "e": 996607, "zh": "人已经很少了", "ko": "사람이 이미 적어졌어", "t": "", "vs": ""}, {"s": 996607, "e": 999354, "zh": "最后压轴把中国馆看了", "ko": "마지막으로 중국관을 봤어", "t": "", "vs": ""}, {"s": 999354, "e": 1002101, "zh": "反正中国馆就是很简单", "ko": "어쨌든 중국관은 간단해", "t": "", "vs": ""}, {"s": 1002101, "e": 1003749, "zh": "只给的造型啊", "ko": "디자인만 줬어", "t": "", "vs": ""}, {"s": 1003749, "e": 1006221, "zh": "就是竹简竹简加汉字。", "ko": "대나무 죽간과 한자야", "t": "", "vs": ""}, {"s": 1006221, "e": 1011988, "zh": "其实网上很多人批评呢说像什么党支部中心是吧？", "ko": "실제로 인터넷에서 많은 사람들이 비판하더라. 마치 당 지부 센터 같다고", "t": "key", "vs": ""}, {"s": 1011988, "e": 1016108, "zh": "太土了，都说你像欧美做那种很抽象", "ko": "너무 촌스럽다고, 유럽이나 미국처럼 추상적이고", "t": "", "vs": ""}, {"s": 1016108, "e": 1019130, "zh": "很有美感，现代感那种建筑。", "ko": "미적 감각과 현대적인 건축을 한다고", "t": "", "vs": ""}, {"s": 1019480, "e": 1023743, "zh": "他其实没有宣传文化的这个内核需求在那咱这个需", "ko": "사실 문화 홍보의 핵심 요구가 없어. 우리의 필요는", "t": "", "vs": ""}, {"s": 1023743, "e": 1024519, "zh": "求不一样。", "ko": "달라", "t": "", "vs": ""}, {"s": 1024519, "e": 1027038, "zh": "所以说咱有宣传文化这个需求", "ko": "그래서 우리는 문화 홍보의 필요가 있어", "t": "", "vs": ""}, {"s": 1027038, "e": 1029364, "zh": "这个建筑就能达到这个目的", "ko": "이 건물은 그 목적을 달성할 수 있어", "t": "", "vs": ""}, {"s": 1029364, "e": 1031302, "zh": "它就是一个好的建筑啊", "ko": "좋은 건축물이야", "t": "key", "vs": ""}, {"s": 1031302, "e": 1031690, "zh": "对对。", "ko": "응, 응.", "t": "", "vs": ""}, {"s": 1033550, "e": 1039901, "zh": "来了啊来了来了进来了哦", "ko": "왔어, 왔어, 들어왔네", "t": "", "vs": ""}, {"s": 1039901, "e": 1046830, "zh": "潘展乐，哎呀，可以牌面牌面儿。", "ko": "판잔러, 야, 대박이네", "t": "", "vs": ""}, {"s": 1047470, "e": 1048640, "zh": "宇航员。", "ko": "우주비행사.", "t": "", "vs": ""}, {"s": 1050360, "e": 1053830, "zh": "哇塞，这大圆盘子。", "ko": "와, 이 큰 원반이", "t": "", "vs": ""}, {"s": 1057460, "e": 1058850, "zh": "壮观啊。", "ko": "장엄하네", "t": "", "vs": ""}, {"s": 1064080, "e": 1064700, "zh": "是谢。", "ko": "(인식 불명)", "t": "", "vs": ""}, {"s": 1070320, "e": 1075264, "zh": "俺这也从博物馆带点宝贝过来啊", "ko": "나도 박물관에서 보물 좀 가져왔어", "t": "", "vs": ""}, {"s": 1075264, "e": 1080914, "zh": "主主二二十四节气也是很好的题材啊", "ko": "24절기도 좋은 소재야", "t": "", "vs": ""}, {"s": 1080914, "e": 1083740, "zh": "宣传我们文化春分。", "ko": "춘분, 우리 문화 홍보", "t": "", "vs": ""}, {"s": 1084570, "e": 1088970, "zh": "清明啊这个英语就直译的clearandbri", "ko": "청명, 영어로는 직역해서 clear and bright", "t": "", "vs": ""}, {"s": 1088970, "e": 1090370, "zh": "ght,清明无语", "ko": "청명, 말도 안 돼", "t": "", "vs": ""}, {"s": 1090370, "e": 1092970, "zh": "greening真是谷子语", "ko": "greening, 진짜 농담이네", "t": "", "vs": ""}, {"s": 1092970, "e": 1095570, "zh": "立夏startsummer.", "ko": "입하, start summer", "t": "", "vs": ""}, {"s": 1096060, "e": 1099460, "zh": "就是英文翻译的挺好好理解。", "ko": "영문 번역이 이해하기 쉬워", "t": "", "vs": ""}, {"s": 1101350, "e": 1104104, "zh": "三星堆这宝贝都搬过来了", "ko": "삼성퇴 보물 다 가져왔네", "t": "", "vs": ""}, {"s": 1104104, "e": 1109362, "zh": "挺给面的，就专门一块儿讲良楚古城的良楚申遗啊", "ko": "대우해주네, 량주 고도 유네스코 등재 이야기만 따로 해", "t": "", "vs": ""}, {"s": 1109362, "e": 1111866, "zh": "这非常重要的一个遗址。", "ko": "매우 중요한 유적지야", "t": "", "vs": ""}, {"s": 1111866, "e": 1114119, "zh": "虽然现在什么也不剩", "ko": "지금은 아무것도 안 남았지만", "t": "", "vs": ""}, {"s": 1114119, "e": 1117875, "zh": "但是他认证了华夏文明从夏开始啊", "ko": "하화 문명이 하나라에서 시작됐음을 증명해", "t": "", "vs": ""}, {"s": 1117875, "e": 1119627, "zh": "没有这儿的遗迹", "ko": "여기 유적이 없으면", "t": "", "vs": ""}, {"s": 1119627, "e": 1120128, "zh": "发掘。", "ko": "발굴이 안 됐으면", "t": "", "vs": ""}, {"s": 1120128, "e": 1121630, "zh": "外国人不认咱", "ko": "외국인들이 인정 안 해", "t": "", "vs": ""}, {"s": 1121630, "e": 1123884, "zh": "五千年，只有三千年了", "ko": "5천 년이 아니라 3천 년이 돼", "t": "", "vs": ""}, {"s": 1123884, "e": 1125386, "zh": "夏那都不认咱", "ko": "하나라도 인정 안 해", "t": "", "vs": ""}, {"s": 1125386, "e": 1127640, "zh": "但是有了他就有证据。", "ko": "하지만 여기가 있으니 증거가 있는 거야", "t": "", "vs": ""}, {"s": 1128250, "e": 1132778, "zh": "嗯，这块拎出来单独讲讲还是挺不错的。", "ko": "응, 이 부분은 따로 떼어 이야기해도 꽤 괜찮겠네.", "t": "", "vs": ""}, {"s": 1132778, "e": 1137872, "zh": "然后这一块迎合大环境也是啊科技环保嗯", "ko": "그리고 이 부분은 대세인 기술과 환경 보호를 반영했어", "t": "", "vs": ""}, {"s": 1137872, "e": 1140420, "zh": "挺好，紧跟潮流的也是。", "ko": "좋아, 트렌드를 잘 따라가는 거야", "t": "", "vs": ""}, {"s": 1141100, "e": 1141576, "zh": "好吗？", "ko": "좋지?", "t": "", "vs": ""}, {"s": 1141576, "e": 1144194, "zh": "这活好啊，这阿童木孙悟空", "ko": "이거 재밌네. 아톰이랑 손오공도 있네.", "t": "", "vs": ""}, {"s": 1144194, "e": 1147051, "zh": "这也属于是中日文化交流了。", "ko": "이것도 일중 문화 교류에 속하죠.", "t": "", "vs": ""}, {"s": 1147051, "e": 1148956, "zh": "那这边全是放中文", "ko": "여기엔 중국어만 다 붙여 놨네요.", "t": "", "vs": ""}, {"s": 1148956, "e": 1150384, "zh": "全是放汉字儿", "ko": "한자만 가득하죠.", "t": "", "vs": ""}, {"s": 1150384, "e": 1154670, "zh": "不放英文，估计就是给中国人和日本人看的。", "ko": "영어는 안 붙여 놨으니 중국인과 일본인을 위한 거겠네요.", "t": "", "vs": ""}, {"s": 1155550, "e": 1158080, "zh": "其他老外不需要他们搞懂了。", "ko": "다른 외국인은 이해 못 해도 상관없다는 거죠.", "t": "", "vs": ""}, {"s": 1160610, "e": 1164361, "zh": "嗯，咱最后也是放个电影总结", "ko": "음, 마지막엔 영화 요약도 하고", "t": "", "vs": ""}, {"s": 1164361, "e": 1167175, "zh": "升华一下，宣宣传一下", "ko": "의미를 한층 높이고 홍보도 하고", "t": "", "vs": ""}, {"s": 1167175, "e": 1169051, "zh": "咱这个活力啊", "ko": "우리 이 활력 넘치는 느낌,", "t": "", "vs": ""}, {"s": 1169051, "e": 1171240, "zh": "挺好，挺挺圆满了。", "ko": "정말 좋네요. 꽤 완벽해요.", "t": "", "vs": ""}, {"s": 1171740, "e": 1176431, "zh": "真的我觉得像是在中国馆这种就是我心目中合格的", "ko": "진짜 중국관 같은 게 제 생각엔", "t": "key", "vs": ""}, {"s": 1176431, "e": 1178350, "zh": "一个世博展馆的样子。", "ko": "올바른 엑스포관의 모습이에요.", "t": "", "vs": ""}, {"s": 1178350, "e": 1180696, "zh": "就是你起码要有这种文化", "ko": "적어도 이런 문화적 요소가 있어야 하고", "t": "", "vs": ""}, {"s": 1180696, "e": 1183041, "zh": "然后有再拿些博物来对吧？", "ko": "박물관 같은 것도 있어야 하죠?", "t": "", "vs": ""}, {"s": 1183041, "e": 1184747, "zh": "然后再你放宣传片", "ko": "그리고 홍보 영상도 틀고", "t": "", "vs": ""}, {"s": 1184747, "e": 1188372, "zh": "这个没问题，但是你不能只放宣传片是吧？", "ko": "이건 괜찮은데, 홍보 영상만 틀면 안 되죠?", "t": "", "vs": ""}, {"s": 1188372, "e": 1190504, "zh": "那不能别的国家糊弄的", "ko": "다른 나라를 속이는 거랑 다를 바 없어요.", "t": "", "vs": ""}, {"s": 1190504, "e": 1191784, "zh": "就光放宣传片", "ko": "홍보 영상만 틀면", "t": "", "vs": ""}, {"s": 1191784, "e": 1194130, "zh": "那就有点儿太不够意思了。", "ko": "그렇게 홍보 영상만 틀면 너무 성의 없는 거지.", "t": "key", "vs": ""}, {"s": 1194820, "e": 1198155, "zh": "反正而且这次我对我其实颠覆挺大的。", "ko": "어쨌든 이번엔 제게 큰 충격이었어요.", "t": "", "vs": ""}, {"s": 1198155, "e": 1202741, "zh": "我对这个世博展馆印象还停留在当时上海世博会的", "ko": "엑스포관에 대한 인상이 아직 상하이 엑스포 때", "t": "", "vs": ""}, {"s": 1202741, "e": 1203783, "zh": "时候啊那地。", "ko": "그때 그 느낌에 머물러 있었거든요.", "t": "", "vs": ""}, {"s": 1203783, "e": 1206702, "zh": "然后但是现在中国还是那种风格", "ko": "그런데 지금 중국은 여전히 그 스타일이고", "t": "", "vs": ""}, {"s": 1206702, "e": 1208370, "zh": "可以说比较传统啊。", "ko": "상당히 전통적이에요.", "t": "", "vs": ""}, {"s": 1209540, "e": 1210858, "zh": "最后一个馆啊", "ko": "마지막 관이네요.", "t": "", "vs": ""}, {"s": 1210858, "e": 1213495, "zh": "比利时馆现在应该都没人看", "ko": "벨기에관은 이제 아무도 안 볼 거예요.", "t": "", "vs": ""}, {"s": 1213495, "e": 1215693, "zh": "我自己一个人逛一个馆", "ko": "나 혼자 한 관을 다 돌아다니는 게", "t": "", "vs": ""}, {"s": 1215693, "e": 1218330, "zh": "太爽了啊，这也是一个好馆啊", "ko": "정말 즐거웠어요. 좋은 관이었어요.", "t": "", "vs": ""}, {"s": 1218330, "e": 1218770, "zh": "推荐。", "ko": "추천합니다.", "t": "key", "vs": ""}, {"s": 1218770, "e": 1220528, "zh": "比利时是值得推荐", "ko": "벨기에는 추천할 만해요.", "t": "key", "vs": ""}, {"s": 1220528, "e": 1222286, "zh": "又有内容又有艺术", "ko": "내용도 있고 예술적이에요.", "t": "", "vs": ""}, {"s": 1222286, "e": 1223824, "zh": "主要是很艺术啊", "ko": "특히 예술적이죠.", "t": "", "vs": ""}, {"s": 1223824, "e": 1225143, "zh": "美感，很有美感", "ko": "미감이 정말 좋았어요.", "t": "", "vs": ""}, {"s": 1225143, "e": 1226462, "zh": "尤其是天台啊", "ko": "특히 옥상이야.", "t": "", "vs": ""}, {"s": 1226462, "e": 1228440, "zh": "天台非常棒，值得去景。", "ko": "옥상이 정말 멋져, 가볼 만해.", "t": "key", "vs": ""}, {"s": 1230060, "e": 1230710, "zh": "跟我说。", "ko": "나한테 말해줘.", "t": "", "vs": ""}, {"s": 1236540, "e": 1237737, "zh": "最后的最后啊", "ko": "마지막으로 하나만 더.", "t": "", "vs": ""}, {"s": 1237737, "e": 1240731, "zh": "趁人家关门之前捡漏了一个埃及馆", "ko": "닫기 전에 이집트관을 급히 봤어.", "t": "", "vs": ""}, {"s": 1240731, "e": 1243326, "zh": "埃及馆今天排队时间也特别长", "ko": "이집트관 줄도 오늘 엄청 길었어.", "t": "", "vs": ""}, {"s": 1243326, "e": 1244923, "zh": "我一直想看都没看", "ko": "계속 보고 싶었는데 이제야 봤네.", "t": "", "vs": ""}, {"s": 1244923, "e": 1246520, "zh": "今天最后捡漏一个。", "ko": "오늘 마지막에 급히 봤어.", "t": "", "vs": ""}, {"s": 1247940, "e": 1250230, "zh": "Doingeveryoneyeah.", "ko": "(인식 불명)", "t": "", "vs": ""}, {"s": 1255450, "e": 1257431, "zh": "在这逛了一天了", "ko": "여기서 하루 종일 돌아다녔네.", "t": "", "vs": ""}, {"s": 1257431, "e": 1259695, "zh": "东道主都忘看了啊", "ko": "주인 나라관도 못 봤어.", "t": "", "vs": ""}, {"s": 1259695, "e": 1265355, "zh": "这就是本本馆见和它这个大圆环啊是相呼应的", "ko": "이건 본관과 큰 원형 구조가 서로 어울려.", "t": "", "vs": ""}, {"s": 1265355, "e": 1266770, "zh": "都是木质的。", "ko": "다 목재로 되어 있어.", "t": "", "vs": ""}, {"s": 1268660, "e": 1272368, "zh": "这确实有一些美感的这个建筑嗯", "ko": "정말 미적 감각이 있는 건축이야.", "t": "good", "vs": ""}, {"s": 1272368, "e": 1274222, "zh": "没有那么具象化", "ko": "그렇게 구체적이지는 않고.", "t": "", "vs": ""}, {"s": 1274222, "e": 1277930, "zh": "是一定的抽象的美感是个好建筑。", "ko": "추상적인 아름다움이 있어, 좋은 건축이야.", "t": "good", "vs": ""}, {"s": 1279650, "e": 1282319, "zh": "这边就是东门出来的地铁站啊", "ko": "여기가 동문으로 나오는 지하철이야.", "t": "", "vs": ""}, {"s": 1282319, "e": 1284988, "zh": "孟州地铁站直通世博会的东门。", "ko": "유메시마역에서 엑스포 동문으로 바로 연결돼.", "t": "", "vs": ""}, {"s": 1284988, "e": 1286836, "zh": "最后给大家总结一下", "ko": "마지막으로 정리해 볼게.", "t": "", "vs": ""}, {"s": 1286836, "e": 1289300, "zh": "今天吧世博会值不值得来呢？", "ko": "오늘 엑스포, 가볼 만한가?", "t": "", "vs": ""}, {"s": 1289300, "e": 1290943, "zh": "我觉得还是值得的", "ko": "나는 가볼 만하다고 생각해.", "t": "good", "vs": ""}, {"s": 1290943, "e": 1293202, "zh": "但是不要抱太高的期望啊", "ko": "하지만 기대는 너무 높이지 마.", "t": "bad", "vs": ""}, {"s": 1293202, "e": 1295255, "zh": "跟上海肯定是没法比的", "ko": "상하이랑은 비교할 수 없어.", "t": "bad", "vs": "중국"}, {"s": 1295255, "e": 1297719, "zh": "但是还是有很多的值得看的", "ko": "하지만 볼 만한 건 많아.", "t": "", "vs": ""}, {"s": 1297719, "e": 1299362, "zh": "觉得尤其是建筑啊", "ko": "특히 건축물이야.", "t": "", "vs": ""}, {"s": 1299362, "e": 1302237, "zh": "它的外表本身比它内在更有看头。", "ko": "외관이 내부보다 더 볼 만해.", "t": "eval", "vs": ""}, {"s": 1302237, "e": 1305728, "zh": "然后如果你喜欢人文的相关民俗相关的", "ko": "인문이나 민속에 관심이 있다면.", "t": "", "vs": ""}, {"s": 1305728, "e": 1308808, "zh": "我其实更推荐你去看中小的国家啊", "ko": "중소 국가관을 더 추천해.", "t": "", "vs": ""}, {"s": 1308808, "e": 1310861, "zh": "尤其是小国家的集合馆", "ko": "특히 소국 집합관이야.", "t": "key", "vs": ""}, {"s": 1310861, "e": 1312709, "zh": "那边的人文很有意思", "ko": "거기 인문 요소가 정말 재미있어.", "t": "", "vs": ""}, {"s": 1312709, "e": 1315379, "zh": "很多民族特色的东西包括中型", "ko": "민족 특색 있는 것들이 많고, 중동도.", "t": "", "vs": ""}, {"s": 1315379, "e": 1317637, "zh": "尤其是中东和东南亚国家", "ko": "특히 중동과 동남아 국가들이야.", "t": "", "vs": ""}, {"s": 1317637, "e": 1320101, "zh": "他们的做的更加用心一点啊", "ko": "더욱 세심하게 준비했어.", "t": "", "vs": ""}, {"s": 1320101, "e": 1321950, "zh": "能看的东西更多一点。", "ko": "볼 수 있는 게 더 많아졌어.", "t": "", "vs": ""}, {"s": 1321950, "e": 1323735, "zh": "然后还有一个建议啊", "ko": "그리고 한 가지 제안이 있어.", "t": "", "vs": ""}, {"s": 1323735, "e": 1326314, "zh": "就是时间上你要是腿力好的话", "ko": "시간적으로 다리가 좋다면,", "t": "", "vs": ""}, {"s": 1326314, "e": 1328297, "zh": "像我一样，早上九点入场", "ko": "나처럼 아침 9시에 입장하고", "t": "key", "vs": ""}, {"s": 1328297, "e": 1329487, "zh": "现在晚上十点", "ko": "밤 10시까지 있다가", "t": "", "vs": ""}, {"s": 1329487, "e": 1330479, "zh": "最后再出场。", "ko": "마지막에 나오는 거야.", "t": "", "vs": ""}, {"s": 1330479, "e": 1332860, "zh": "你基本把全场都看差不多了", "ko": "거의 전시장을 다 돌아본 셈이야.", "t": "", "vs": ""}, {"s": 1332860, "e": 1334843, "zh": "因为这边很小很好走啊", "ko": "여기는 작아서 걷기 쉬워.", "t": "good", "vs": ""}, {"s": 1334843, "e": 1337224, "zh": "然后一天三万多步往前走了。", "ko": "하루에 3만 보 이상 걸었어.", "t": "", "vs": ""}, {"s": 1337224, "e": 1340596, "zh": "然后中午的时间呢就去看那些小国家啊", "ko": "점심 시간에는 작은 나라들을 보고", "t": "", "vs": ""}, {"s": 1340596, "e": 1343373, "zh": "然后尤其那集合馆都不要排队的", "ko": "특히 그 집합관은 줄 서지 않아도 돼.", "t": "", "vs": ""}, {"s": 1343373, "e": 1344166, "zh": "还能盖章。", "ko": "인장도 찍을 수 있어.", "t": "", "vs": ""}, {"s": 1344166, "e": 1348531, "zh": "然后早上一大早和最晚上这几段时间来去看那最热", "ko": "아침 일찍이나 늦은 시간에는 인기 있는 큰 전시관을 봐.", "t": "key", "vs": ""}, {"s": 1348531, "e": 1352300, "zh": "门的大馆啊，这是我的攻略还是很实用的ok.", "ko": "이게 내 팁이야, 꽤 유용해. OK?", "t": "key", "vs": ""}, {"s": 1352380, "e": 1353855, "zh": "接着下期视频吧。", "ko": "다음 영상에서 만나요.", "t": "", "vs": ""}, {"s": 1353855, "e": 1354910, "zh": "拜拜朋友们。", "ko": "안녕, 친구들.", "t": "", "vs": ""}], "korea_mentions": [{"i": 200, "kind": "positive", "note": "한국관은 꽤 창의적이라고 긍정적으로 평가한다."}], "frames": [{"i": 3, "f": "BV1wzVAzhETY_3.jpg"}, {"i": 91, "f": "BV1wzVAzhETY_91.jpg"}, {"i": 333, "f": "BV1wzVAzhETY_333.jpg"}, {"i": 429, "f": "BV1wzVAzhETY_429.jpg"}, {"i": 436, "f": "BV1wzVAzhETY_436.jpg"}, {"i": 456, "f": "BV1wzVAzhETY_456.jpg"}]}