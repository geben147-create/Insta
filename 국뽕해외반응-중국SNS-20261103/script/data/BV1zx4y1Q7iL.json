    },
    {
      "s": 426.31,
      "e": 430.13,
      "text": "この日は生パスタのナポリタンもいただきました"
    },
    {
      "s": 430.13,
      "e": 434.39,
      "text": "フレンチ出身の店主が作る料理もおすすめです"
