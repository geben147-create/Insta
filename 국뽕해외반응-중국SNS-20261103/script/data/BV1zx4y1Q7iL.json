  "lines": [
    {
      "s": 0.34,
      "e": 4.46,
      "text": "もちもち、パリパリ、焼きたてのクレープはいかがですか?"
    },
    {
      "s": 5.38,
      "e": 11.02,
      "text": "今日は私たち東京カフェチャンネルが東京の絶品クレープを5店舗ご紹介します"
    },
    {
      "s": 11.02,
      "e": 13.12,
      "text": "ぜひ最後までご覧ください"
    },
    {
      "s": 13.12,
      "e": 13.92,
      "text": "スタート!"
    },
    {
      "s": 19.67,
      "e": 22.87,
      "text": "最初のお店は、ハイちゃんも私も大好きなお店"
    },
    {
      "s": 22.87,
      "e": 26.99,
      "text": "都内屈指の人気を誇るブーランジェリー、ビロン渋谷店"
    },
    {
      "s": 26.99,
      "e": 31.25,
      "text": "店内にはフランス小麦を使用したバケットをはじめ"
    },
    {
      "s": 31.25,
      "e": 34.19,
      "text": "パンや伝統的なフランス菓子が並んでいます"
    },
    {
      "s": 34.19,
      "e": 42.27,
      "text": "2階はクラシックのフランス料理を提供するブラッスリーになっており"
    },
    {
      "s": 42.27,
      "e": 45.79,
      "text": "いろいろな種類のパンが食べられるモーニングメニューは"
    },
    {
      "s": 45.79,
      "e": 47.83,
      "text": "行列ができるほど人気です"
    },
    {
      "s": 47.83,
      "e": 55.69,
      "text": "お店の一角にはクレープ売り場があり"
    },
    {
      "s": 55.69,
      "e": 61.43,
      "text": "フランス直輸入の小麦粉、レトロドールを使用した焼きたてのクレープがいただけます"
    },
    {
      "s": 61.43,
      "e": 66.33,
      "text": "ヘシレバターと砂糖をトッピングしたシンプルなクレープから"
    },
    {
      "s": 66.33,
      "e": 69.19,
      "text": "全部で8種類のクレープが販売されています"
    },
    {
      "s": 69.47,
      "e": 85.3,
      "text": "クレープは注文が入ってから焼き始め"
    },
    {
      "s": 85.3,
      "e": 87.04,
      "text": "作りたての提供です"
    },
    {
      "s": 87.04,
      "e": 120.76,
      "text": "今回注文したのはキャラメルブールサレとスペキロスです"
    },
    {
      "s": 120.76,
      "e": 127.37,
      "text": "綺麗な層に折りたたまれたクレープが芸術的で美味しそうです"
    },
    {
      "s": 127.37,
      "e": 133.51,
      "text": "スペキロスは自家製のシナモンサブレを砕いたものがトッピングされていて"
    },
    {
      "s": 133.51,
      "e": 136.79,
      "text": "サブレの食感とシナモンの香りが楽しめます"
    },
    {
      "s": 136.79,
      "e": 144.0,
      "text": "キャラメルブールサレは中に自家製の塩キャラメルソースがたっぷり入っています"
    },
    {
      "s": 144.0,
      "e": 148.44,
      "text": "食感はモチッと生地自体にコクがあり"
    },
    {
      "s": 148.44,
      "e": 152.54,
      "text": "何より小麦の香りがたまらない絶品クレープです"
    },
    {
      "s": 152.54,
      "e": 158.65,
      "text": "そしてこの日もお土産にバケットを購入して帰りました"
    },
    {
      "s": 158.65,
      "e": 166.34,
      "text": "続いては愛知県岡崎初の八百屋"
    },
    {
      "s": 166.34,
      "e": 170.54,
      "text": "大和スーパーが展開するタカフェ恵比寿店のご紹介です"
    },
    {
      "s": 170.54,
      "e": 175.46,
      "text": "フルーツサンドをはじめパフェクレープトーストと"
    },
    {
      "s": 175.46,
      "e": 179.34,
      "text": "旬のフルーツを使ったスイーツやドリンクがいただけるお店です"
    },
    {
      "s": 179.34,
      "e": 185.78,
      "text": "フルーツがゴロッと入ったフルーツサンドもこの通り種類豊富です"
    },
    {
      "s": 185.78,
      "e": 208.72,
      "text": "タカフェでは定番のシュガーバタークレープをはじめ"
    },
    {
      "s": 209.0,
      "e": 212.0,
      "text": "旬の果物を使用した式間限定クレープや"
    },
    {
      "s": 212.0,
      "e": 214.04,
      "text": "おかずクレープを提供しています"
    },
    {
      "s": 214.04,
      "e": 216.76,
      "text": "今回は旬の果物"
    },
    {
      "s": 216.76,
      "e": 219.84,
      "text": "いちごをたっぷりと使用したクレープを提供中"
    },
    {
      "s": 219.84,
      "e": 221.64,
      "text": "と聞いて伺ってきました"
    },
    {
      "s": 221.64,
      "e": 238.55,
      "text": "この日のいちごの品種は福岡県産のアマオ"
    },
    {
      "s": 238.55,
      "e": 242.13,
      "text": "大和オリジナル生クリームとスポンジ"
    },
    {
      "s": 242.13,
      "e": 244.33,
      "text": "ラスクなどがトッピングされており"
    },
    {
      "s": 244.33,
      "e": 246.67,
      "text": "ケーキのようなクレープに仕上げていきます"
    },
    {
      "s": 246.67,
      "e": 265.98,
      "text": "クレープを巻いた後はスライスしたアマオを"
    },
    {
      "s": 265.98,
      "e": 267.82,
      "text": "花びらのようにトッピングしていきます"
    },
    {
      "s": 267.82,
      "e": 273.36,
      "text": "そして最後に真ん中にアマオを一粒乗せて完成です"
    },
    {
      "s": 273.36,
      "e": 277.66,
      "text": "その名もいちごフラワークレープの登場です"
    },
    {
      "s": 277.66,
      "e": 280.86,
      "text": "ドリンクはいちごの果肉がたっぷり入った"
    },
    {
      "s": 280.86,
      "e": 282.82,
      "text": "いちごミルクを注文しました"
    },
    {
      "s": 282.82,
      "e": 290.42,
      "text": "アマオを約9個使用したいちごフラワー"
    },
    {
      "s": 290.42,
      "e": 294.62,
      "text": "トップにも中にもいちごたっぷりで華やかな見た目です"
    },
    {
      "s": 294.62,
      "e": 299.46,
      "text": "八百屋さんが選別しているいちごというだけあって"
    },
    {
      "s": 299.46,
      "e": 302.16,
      "text": "甘くてジューシーで美味しいです"
    },
    {
      "s": 302.16,
      "e": 305.7,
      "text": "クレープ生地は焼きたては少しパリッと"
    },
    {
      "s": 305.7,
      "e": 307.98,
