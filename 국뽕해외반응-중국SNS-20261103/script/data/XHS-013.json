: "고사리나물, 쫄깃하고 부드러워요", "t": "", "vs": ""}, {"s": 65304, "e": 67210, "zh": "鲜爽回甘。", "ko": "상큼하고 뒷맛이 달아요", "t": "", "vs": ""}, {"s": 72250, "e": 78050, "zh": "腌萝卜条脆嫩爽口咸甜微辣。", "ko": "무절임, 아삭하고 짭짤달콤 살짝 매워요", "t": "", "vs": ""}, {"s": 81930, "e": 86790, "zh": "辣炒小鱼干干香酥脆鲜辣提味。", "ko": "멸치볶음, 고소하고 바삭하고 칼칼해요", "t": "", "vs": ""}, {"s": 96260, "e": 101085, "zh": "烤海苔薄脆鲜香咸香", "ko": "구운 김, 얇고 바삭하고 고소하고 짭짤해요", "t": "", "vs": ""}, {"s": 101085, "e": 111810, "zh": "适口养乐多，哪个卷心菜沙拉清甜脆嫩爽口解腻。", "ko": "야쿠르트도 곁들이고, 양배추 샐러드는 달고 아삭해서 느끼함을 잡아줘요", "t": "good", "vs": ""}, {"s": 118970, "e": 121755, "zh": "蒸卷心菜，软嫩", "ko": "찐 양배추, 부드럽고", "t": "", "vs": ""}, {"s": 121755, "e": 124540, "zh": "清甜清淡本味。", "ko": "달고 담백한 본연의 맛이에요", "t": "", "vs": ""}, {"s": 126630, "e": 130354, "zh": "炖排骨肉质酥烂", "ko": "갈비찜, 고기가 부드럽게 무르고", "t": "", "vs": ""}, {"s": 130354, "e": 134610, "zh": "酱香浓郁，多搞一点。", "ko": "양념이 진해요, 더 담아요", "t": "", "vs": ""}, {"s": 136210, "e": 141530, "zh": "紫菜包饭米润台香馅风爽脆。", "ko": "김밥, 밥은 촉촉하고 속재료는 아삭해요", "t": "", "vs": ""}, {"s": 144730, "e": 148094, "zh": "韩式大酱汤，鲜辣醇厚", "ko": "된장찌개, 칼칼하고 구수해요", "t": "good", "vs": ""}, {"s": 148094, "e": 149590, "zh": "汤浓味足。", "ko": "국물이 진하고 맛이 깊어요", "t": "good", "vs": ""}, {"s": 151310, "e": 152870, "zh": "倒入小锅。", "ko": "작은 냄비에 붓고", "t": "", "vs": ""}, {"s": 157720, "e": 159380, "zh": "加点汤水。", "ko": "국물을 좀 더하고", "t": "", "vs": ""}, {"s": 167590, "e": 169310, "zh": "开火煮下。", "ko": "불을 켜서 끓여요", "t": "", "vs": ""}, {"s": 175810, "e": 178880, "zh": "来一包韩国本地泡面。", "ko": "한국 현지 라면 하나를 뜯어요", "t": "", "vs": ""}, {"s": 185890, "e": 186950, "zh": "甩一甩。", "ko": "탈탈 털고", "t": "", "vs": ""}, {"s": 188430, "e": 189900, "zh": "放调料包。", "ko": "스프를 넣고", "t": "", "vs": ""}, {"s": 200070, "e": 201440, "zh": "加面饼。", "ko": "면을 넣고", "t": "", "vs": ""}, {"s": 204420, "e": 206590, "zh": "加点干辣椒粉。", "ko": "고춧가루를 좀 넣고", "t": "", "vs": ""}, {"s": 208340, "e": 212200, "zh": "胡椒粉搞点葱花。", "ko": "후추와 파를 넣어요", "t": "", "vs": ""}, {"s": 216160, "e": 217840, "zh": "小火慢炖。", "ko": "약불에서 천천히 끓이다", "t": "", "vs": ""}, {"s": 222480, "e": 223630, "zh": "关火。", "ko": "불을 꺼요", "t": "", "vs": ""}, {"s": 229270, "e": 230510, "zh": "傍晚。", "ko": "저녁이에요", "t": "", "vs": ""}, {"s": 238210, "e": 239760, "zh": "坐下开吃。", "ko": "자리에 앉아 먹기 시작해요", "t": "", "vs": ""}], "frames": [{"i": 2, "f": "XHS-013_2.jpg"}, {"i": 6, "f": "XHS-013_6.jpg"}, {"i": 21, "f": "XHS-013_21.jpg"}]}