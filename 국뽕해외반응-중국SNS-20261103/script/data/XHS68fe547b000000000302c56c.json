  "verdict": "",
  "lines": [
    {
      "s": 0.0,
      "e": 3.72,
      "text": "这是韩国最新第四架下线的KF-21猎鹰战斗机"
    },
    {
      "s": 3.72,
      "e": 5.4,
      "text": "在画面里不光飞机亮眼"
    },
    {
      "s": 5.4,
      "e": 9.02,
      "text": "连前面牵引它的地面车辆都已经实现了无人化操作"
    },
    {
      "s": 9.02,
      "e": 10.72,
      "text": "看起来科技感十足"
    },
    {
      "s": 10.72,
      "e": 13.9,
      "text": "这架战机是韩国二十多年航空梦的成果"
    },
    {
      "s": 13.9,
      "e": 17.16,
      "text": "项目最早启动于2001年与印尼联合研发"
    },
    {
      "s": 17.16,
      "e": 21.64,
      "text": "目标是打造一款介于F-16与F-35之间的中型隐身机"
    },
    {
      "s": 21.64,
      "e": 23.56,
      "text": "2021年首飞成功"
    },
    {
      "s": 23.56,
      "e": 26.82,
      "text": "标志着韩国正式迈入准五代机行列"
    },
    {
      "s": 26.82,
      "e": 30.66,
      "text": "外观上KF-21像是F-22的脸F-35的身"
    },
    {
      "s": 30.66,
      "e": 33.36,
      "text": "采用双发布局与隐身气动线条"
    },
    {
      "s": 33.36,
      "e": 34.88,
      "text": "但因没有内置弹舱"
    },
    {
      "s": 34.88,
      "e": 37.76,
      "text": "隐身性能仍有限只能算4.5代机"
    },
    {
      "s": 37.76,
      "e": 42.1,
      "text": "它配备韩国自主研发的ASA雷达和先进航电系统"
    },
    {
      "s": 42.1,
      "e": 44.92,
      "text": "具备超时距打击与多目标作战能力"
    },
    {
      "s": 44.92,
      "e": 48.9,
      "text": "不过KF-21想要取代F-35还差点火候"
    },
    {
      "s": 48.9,
      "e": 52.32,
      "text": "毕竟它在隐身图层任务软件等关键领域"
    },
    {
      "s": 52.32,
      "e": 54.22,
      "text": "仍依赖美方技术与授权"
    },
    {
      "s": 54.22,
      "e": 57.44,
      "text": "可以说这架战机更多是一块试金石"
    },
    {
      "s": 57.44,
      "e": 61.12,
      "text": "验证韩国能否真正走得上自主隐身战机的道路"
    }
  ],
  "chapters": []
}