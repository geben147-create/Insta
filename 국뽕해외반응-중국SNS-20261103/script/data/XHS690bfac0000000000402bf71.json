  "lines": [
    {
      "s": 0.2,
      "e": 1.3,
      "text": "最近刷了个视频"
    },
    {
      "s": 1.3,
      "e": 3.56,
      "text": "韩国网友自制的KF-21"
    },
    {
      "s": 3.56,
      "e": 5.38,
      "text": "把歼35打得落花流水"
    },
    {
      "s": 5.38,
      "e": 6.38,
      "text": "配乐燃爆"
    },
    {
      "s": 6.38,
      "e": 7.86,
      "text": "特效堪比好莱坞"
    },
    {
      "s": 7.86,
      "e": 8.92,
      "text": "看完我只能说"
    },
    {
      "s": 8.92,
      "e": 10.52,
      "text": "这届网友特效做得不错"
    },
    {
      "s": 10.52,
      "e": 12.02,
      "text": "下次别做了"
    },
    {
      "s": 12.02,
      "e": 13.04,
      "text": "话说这年头"
    },
    {
      "s": 13.04,
      "e": 14.56,
      "text": "但凡是款新战机"
    },
    {
      "s": 14.56,
      "e": 16.64,
      "text": "都免不了被拉出来比划比划"
    },
    {
      "s": 16.64,
      "e": 17.06,
      "text": "这不"
    },
    {
      "s": 17.06,
      "e": 19.46,
      "text": "韩国的KF-21和咱们的歼35"
    },
    {
      "s": 19.46,
      "e": 21.14,
      "text": "就在网友的键盘下"
    },
    {
      "s": 21.14,
      "e": 22.94,
      "text": "展开了一场世纪对决"
    },
    {
      "s": 22.94,
      "e": 24.68,
      "text": "不过现实中的这两款战机"
    },
    {
      "s": 24.68,
      "e": 27.0,
      "text": "差距大概就像美颜相机里的你"
    },
    {
      "s": 27.0,
      "e": 28.2,
      "text": "和镜子里的你"
    },
    {
      "s": 28.2,
      "e": 29.46,
      "text": "不能说一模一样"
    },
    {
      "s": 29.46,
      "e": 30.86,
      "text": "只能说毫不相待"
    },
    {
      "s": 30.86,
      "e": 32.22,
      "text": "先来看看设计思路"
    },
    {
      "s": 32.22,
      "e": 34.92,
      "text": "KF-21走的是性价比路线"
    },
    {
      "s": 34.92,
      "e": 35.5,
      "text": "说白了"
    },
    {
      "s": 35.5,
      "e": 37.22,
      "text": "就是在四代机和五代机之间"
    },
    {
      "s": 37.22,
      "e": 37.9,
      "text": "找了个夹放"
    },
    {
      "s": 37.9,
      "e": 39.78,
      "text": "准备用亲民价格打开市场"
    },
    {
      "s": 39.78,
      "e": 41.62,
      "text": "这思路很像某宝爆款"
    },
    {
      "s": 41.62,
      "e": 42.5,
      "text": "功能齐全"
    },
    {
      "s": 42.5,
      "e": 43.22,
      "text": "价格美丽"
    },
    {
      "s": 43.22,
      "e": 44.56,
      "text": "至于实际效果嘛"
    },
    {
      "s": 44.56,
      "e": 45.62,
      "text": "你懂的"
    },
    {
      "s": 45.62,
      "e": 47.62,
      "text": "而咱们的歼35就不同了"
    },
    {
      "s": 47.62,
      "e": 48.88,
      "text": "人家生来就是高富帅"
    },
    {
      "s": 48.88,
      "e": 50.18,
      "text": "不仅要上航母"
    },
    {
      "s": 50.18,
      "e": 51.82,
      "text": "还要带着整个舰队出去溜弯"
    },
    {
      "s": 51.82,
      "e": 53.92,
      "text": "这格局一下子就拉开了"
    },
    {
      "s": 53.92,
      "e": 55.14,
      "text": "说到隐身性能"
    },
    {
      "s": 55.14,
      "e": 57.16,
      "text": "KF-21自称半隐身"
    },
    {
      "s": 57.16,
      "e": 59.36,
      "text": "雷达反射面积大概0.5平方米"
    },
    {
      "s": 59.36,
      "e": 61.7,
      "text": "但问题是他把导弹全都挂在外面"
    },
    {
      "s": 61.7,
      "e": 63.1,
      "text": "这就像穿了件迷彩服"
    },
    {
      "s": 63.1,
      "e": 64.64,
      "text": "却在背上贴了个"
    },
    {
      "s": 64.64,
      "e": 66.44,
      "text": "我在这里的发光标牌"
    },
    {
      "s": 66.44,
      "e": 68.04,
      "text": "属实是掩耳盗铃了"
    },
    {
      "s": 68.04,
      "e": 68.56,
      "text": "反观"
    },
    {
      "s": 68.56,
      "e": 70.26,
      "text": "殲35那是真隐身"
    },
    {
      "s": 70.26,
      "e": 71.88,
      "text": "武器全收在肚子里"
    },
    {
      "s": 71.88,
      "e": 73.12,
      "text": "雷达上压根就看不见"
    },
    {
      "s": 73.12,
      "e": 73.96,
      "text": "这差距"
    },
    {
      "s": 73.96,
      "e": 75.4,
      "text": "好比是夜电蹦迪"
    },
    {
      "s": 75.4,
      "e": 76.94,
      "text": "和特种部队前行的区别"
    },
    {
      "s": 76.94,
      "e": 77.96,
      "text": "动力系统这块"
    },
    {
      "s": 77.96,
      "e": 79.24,
      "text": "更是让人忍惧不惊"
    },
    {
      "s": 79.24,
      "e": 80.62,
      "text": "KF-21用的"
    },
    {
      "s": 80.62,
      "e": 82.34,
      "text": "美国F414发动机"
    },
    {
      "s": 82.34,
      "e": 83.86,
      "text": "属于够用就行的类型"
    },
    {
      "s": 83.86,
      "e": 84.78,
      "text": "超音速巡航"
    },
    {
      "s": 84.78,
      "e": 85.72,
      "text": "想多了"
    },
    {
      "s": 85.72,
      "e": 88.42,
      "text": "而殲35用的是自家研发的发动机"
    },
    {
      "s": 88.42,
      "e": 89.88,
      "text": "不仅能超音速巡航"
    },
    {
      "s": 89.88,
      "e": 91.9,
      "text": "还能在航母上玩短距起飞"
    },
    {
      "s": 91.9,
      "e": 93.62,
      "text": "活脱脱一个别人家的孩子"
    },
    {
      "s": 93.62,
      "e": 95.28,
      "text": "最盗的是航电系统"
    },
    {
      "s": 95.28,
      "e": 97.4,
      "text": "KF-21这边是万国造"
    },
    {
      "s": 97.4,
      "e": 98.52,
      "text": "美国的雷达"
    },
    {
      "s": 98.52,
      "e": 99.84,
      "text": "以色列的航电"
    },
    {
      "s": 99.84,
      "e": 101.32,
      "text": "活像个拼装模型"
    },
    {
      "s": 101.32,
      "e": 103.9,
      "text": "这么多国家的系统要整合在一起"
    },
    {
      "s": 103.9,
      "e": 105.32,
      "text": "想想都头大"
    },
    {
      "s": 105.32,
      "e": 107.08,
      "text": "殲35就省心多了"
    },
    {
      "s": 107.08,
      "e": 107.94,
      "text": "全套过产"
    },
    {
      "s": 107.94,
      "e": 109.28,
      "text": "系统之间配合默契"
    },
    {
      "s": 109.28,
      "e": 111.6,
      "text": "跟空警600预警机搭档起来"
    },
    {
      "s": 111.6,
      "e": 113.56,
      "text": "简直就是战场上的黄金搭档"
    },
    {
      "s": 113.56,
      "e": 115.7,
      "text": "现在KF-21还在实验室阶段"
    },
    {
      "s": 115.7,
      "e": 117.34,
      "text": "标价5000万美元"
    },
    {
      "s": 117.34,
      "e": 118.8,
      "text": "主打一个经济实惠"
    },
    {
      "s": 118.8,
      "e": 121.36,
      "text": "不过核心技术都捏在别人手里"
    },
    {
      "s": 121.36,
      "e": 122.92,
      "text": "想出口还得看别人脸色"
    },
    {
      "s": 122.92,
      "e": 124.46,
      "text": "殲35已经正式上岗"
    },
    {
      "s": 124.46,
      "e": 125.96,
      "text": "虽然贵点要8000万"
    },
    {
      "s": 125.96,
      "e": 127.28,
      "text": "但性能摆在那里"
    },
    {
      "s": 127.28,
      "e": 130.08,
      "text": "未来在国际市场上绝对是F-35的近低"
    },
    {
      "s": 130.08,
      "e": 130.68,
      "text": "说到底"
    },
    {
      "s": 130.68,
      "e": 133.24,
      "text": "网友自制视频就跟美颜相机一样"
    },
    {
      "s": 133.24,
      "e": 134.48,
      "text": "看着开心就好"
    },
    {
      "s": 134.48,
      "e": 138.24,
      "text": "现实中的KF-21是韩国航空工业的一大进步"
    },
    {
      "s": 138.24,
      "e": 139.08,
      "text": "值得肯定"
    },
    {
      "s": 139.08,
      "e": 142.96,
      "text": "但殲35已经是中国航空工业的成熟作品"
    },
    {
      "s": 142.96,
      "e": 144.42,
      "text": "这两者之间差着境界"
    },
    {
      "s": 144.42,
      "e": 147.04,
      "text": "所以打不过就批图的心情可以理解"
    },
    {
      "s": 147.04,
      "e": 148.7,
      "text": "不过咱们还是要尊重事实"
    },
    {
      "s": 148.7,
      "e": 149.36,
      "text": "你说是不是"
    },
    {
      "s": 149.36,
      "e": 150.32,
      "text": "温馨提示"
    },
    {
      "s": 150.32,
      "e": 151.88,
      "text": "本视频纯属技术讨论"
    },
    {
      "s": 151.88,
      "e": 153.76,
      "text": "如有韩国网友感到不适"
    },
    {
      "s": 153.76,
      "e": 155.1,
      "text": "建议多看几遍"
    },
    {
      "s": 155.1,
      "e": 156.3,
      "text": "自制视频压压惊"
    }
  ],
