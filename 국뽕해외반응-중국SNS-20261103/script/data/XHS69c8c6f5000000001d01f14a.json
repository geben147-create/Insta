  "verdict": "",
  "lines": [
    {
      "s": 0.05,
      "e": 3.57,
      "text": "韩国K-21战机首架量产型正式下线"
    },
    {
      "s": 3.57,
      "e": 5.37,
      "text": "2026年3月25日"
    },
    {
      "s": 5.37,
      "e": 9.37,
      "text": "韩国庆上南道四川市的韩国航空航天工业公司工厂内"
    },
    {
      "s": 9.37,
      "e": 12.81,
      "text": "一架喷涂着波拉煤26001编号的双座战斗机"
    },
    {
      "s": 12.81,
      "e": 14.45,
      "text": "缓缓滑行至仪式现场"
    },
    {
      "s": 14.45,
      "e": 17.09,
      "text": "韩国总统李在明清零现场"
    },
    {
      "s": 17.09,
      "e": 22.03,
      "text": "宣布韩国自主研发的KF-21猎鹰战斗机首架量产机正式下线"
    },
    {
      "s": 22.03,
      "e": 24.47,
      "text": "这一刻标志着韩国历经25年"
    },
    {
      "s": 24.47,
      "e": 26.53,
      "text": "艰辛探索的国产战斗机项目"
    },
    {
      "s": 26.53,
      "e": 28.31,
      "text": "终于从蓝图走向现实"
    },
    {
      "s": 28.31,
      "e": 30.39,
      "text": "正式进入批量生产阶段"
    },
    {
      "s": 30.39,
      "e": 33.55,
      "text": "KF-21项目的起源可追溯至2001年"
    },
    {
      "s": 33.55,
      "e": 35.11,
      "text": "持任韩国总统金大中"
    },
    {
      "s": 35.11,
      "e": 38.99,
      "text": "在国防计划中首次提出韩国未来战斗机KF-X项目"
    },
    {
      "s": 38.99,
      "e": 43.83,
      "text": "当时韩国空军的主力战机X-4尾艾和F-55是遗险老旧"
    },
    {
      "s": 43.83,
      "e": 47.99,
      "text": "而引进美国F-35隐身战斗机成本高昂且数量有限"
    },
    {
      "s": 47.99,
      "e": 49.97,
      "text": "难以满足全面换装需求"
    },
    {
      "s": 49.97,
      "e": 51.51,
      "text": "经过多年论证和准备"
    },
    {
      "s": 51.51,
      "e": 56.03,
      "text": "2015年韩国与印度尼西亚正式敲定研发合作协议"
    },
    {
      "s": 56.03,
      "e": 58.19,
      "text": "总开发成本约8.8万亿韩元"
    },
    {
      "s": 58.19,
      "e": 60.43,
      "text": "其中印尼承担20%费用"
    },
    {
      "s": 60.43,
      "e": 61.99,
      "text": "并承诺采购51架"
    },
    {
      "s": 61.99,
      "e": 64.81,
      "text": "韩国航空航天工业公司作为主承包商"
    },
    {
      "s": 64.81,
      "e": 66.51,
      "text": "联合韩华航空航天"
    },
    {
      "s": 66.51,
      "e": 67.81,
      "text": "韩华系统等企业"
    },
    {
      "s": 67.81,
      "e": 70.19,
      "text": "共同推进这一国家重点项目"
    },
    {
      "s": 70.19,
      "e": 71.31,
      "text": "2020年9月"
    },
    {
      "s": 71.31,
      "e": 72.99,
      "text": "首架原型机开始组装"
    },
    {
      "s": 72.99,
      "e": 74.49,
      "text": "2021年4月9日"
    },
    {
      "s": 74.49,
      "e": 76.15,
      "text": "首架原型机正式下线"
    },
    {
      "s": 76.15,
      "e": 78.19,
      "text": "并被命名为KF-21列婴"
    },
    {
      "s": 78.19,
      "e": 79.87,
      "text": "2022年7月19日"
    },
    {
      "s": 79.87,
      "e": 81.81,
      "text": "该机成功完成首飞"
    },
    {
      "s": 81.81,
      "e": 82.91,
      "text": "在随后的测试中"
    },
    {
      "s": 82.91,
      "e": 86.83,
      "text": "6架原型机累计进行了超过1600架次飞行测试"
    },
    {
      "s": 86.83,
      "e": 88.69,
      "text": "完成1.3万个试验科目"
    },
    {
      "s": 88.69,
      "e": 91.57,
      "text": "比原计划提前两个月完成全部研发任务"
    },
    {
      "s": 91.57,
      "e": 93.57,
      "text": "2024年7月10日"
    },
    {
      "s": 93.57,
      "e": 95.11,
      "text": "量产工作正式启动"
    },
    {
      "s": 95.11,
      "e": 96.55,
      "text": "计划到2032年"
    },
    {
      "s": 96.55,
      "e": 98.85,
      "text": "向韩国空军交付120架"
    },
    {
      "s": 98.85,
      "e": 102.39,
      "text": "KF-21被韩国官方定位为4.5代战斗机"
    },
    {
      "s": 102.39,
      "e": 106.13,
      "text": "这一称谓背后体现了韩国航空工业的务实选择"
    },
    {
      "s": 106.13,
      "e": 110.61,
      "text": "最初韩国曾希望研发比肩F-22的第五代隐身战斗机"
    },
    {
      "s": 110.61,
      "e": 112.55,
      "text": "但在2009年技术评估后"
    },
    {
      "s": 112.55,
      "e": 114.57,
      "text": "承认无力单独实现这一指标"
    },
    {
      "s": 114.57,
      "e": 116.91,
      "text": "碎江项目降级为四代半战斗机"
    },
    {
      "s": 116.91,
      "e": 118.39,
      "text": "从技术特征看"
    },
    {
      "s": 118.39,
      "e": 122.57,
      "text": "KF-21采用了与F-22相似的双腿尾双发布局"
    },
    {
      "s": 122.57,
      "e": 124.91,
      "text": "机身大量采用隐身设计元素"
    },
    {
      "s": 124.91,
      "e": 126.09,
      "text": "如F型进气道"
    },
    {
      "s": 126.09,
      "e": 126.97,
      "text": "零型机头"
    },
    {
      "s": 126.97,
      "e": 128.03,
      "text": "倾斜垂尾等"
    },
    {
      "s": 128.03,
      "e": 131.45,
      "text": "该机装备两台美国通用电器F414"
    },
    {
      "s": 131.45,
      "e": 132.33,
      "text": "JA-400"
    },
    {
      "s": 132.33,
      "e": 133.49,
      "text": "K涡扇发动机"
    },
    {
      "s": 133.49,
      "e": 135.43,
      "text": "最大飞行速度1.8马赫"
    },
    {
      "s": 135.43,
      "e": 137.51,
      "text": "最大起飞重量25.4吨"
    },
    {
      "s": 137.51,
      "e": 139.63,
      "text": "最大载荷7.7吨"
    },
    {
      "s": 139.63,
      "e": 141.77,
      "text": "转场航程2480公里"
    },
    {
      "s": 141.77,
      "e": 145.01,
      "text": "然而KF-21最受争议的是其隐身能力"
    },
    {
      "s": 145.01,
      "e": 146.11,
      "text": "由于技术限制"
    },
    {
      "s": 146.11,
      "e": 148.17,
      "text": "该机未设计内置弹舱"
    },
    {
      "s": 148.17,
      "e": 151.19,
      "text": "武器采用机腹半埋式和腋下挂载方式"
    },
    {
      "s": 151.19,
      "e": 153.39,
      "text": "这使其雷达反射面积大幅增加"
    },
    {
      "s": 153.39,
      "e": 155.31,
      "text": "无法实现真正的隐身作战"
    },
    {
      "s": 155.31,
      "e": 157.63,
      "text": "军事专家王亚南指出"
    },
    {
      "s": 157.63,
      "e": 160.41,
      "text": "KF-21具备一定的隐身设计特征"
    },
    {
      "s": 160.41,
      "e": 163.05,
      "text": "但目前仍不具备完全的隐身作战能力"
    },
    {
      "s": 163.05,
      "e": 166.77,
      "text": "韩国为KF-21制定了清晰的三阶段发展路线"
    },
    {
      "s": 166.77,
      "e": 169.23,
      "text": "体现了渐进式技术积累的思路"
    },
    {
      "s": 169.23,
      "e": 171.83,
      "text": "Block E版本专注于空对空作战能力"
    },
    {
      "s": 171.83,
      "e": 173.51,
      "text": "配备有源相控阵雷达"
    },
    {
      "s": 173.51,
      "e": 175.13,
      "text": "棚外搜索与跟踪系统"
    },
    {
      "s": 175.13,
      "e": 176.13,
      "text": "主要武器包括"
    }
  ],
  "chapters": []
}