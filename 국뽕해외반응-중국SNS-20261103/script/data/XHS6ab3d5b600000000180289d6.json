  "verdict": "",
  "lines": [
    {
      "s": 0.0,
      "e": 2.66,
      "text": "花80亿美元历时20多年研发"
    },
    {
      "s": 2.66,
      "e": 5.42,
      "text": "韩国终于亮出了自己的隐身战机"
    },
    {
      "s": 5.42,
      "e": 6.9,
      "text": "然而首飞亮相后"
    },
    {
      "s": 6.9,
      "e": 8.54,
      "text": "全网瞬间沸腾"
    },
    {
      "s": 8.54,
      "e": 10.56,
      "text": "这到底是韩国军工的逆袭"
    },
    {
      "s": 10.56,
      "e": 12.76,
      "text": "还是披着隐身外衣的山寨货"
    },
    {
      "s": 12.76,
      "e": 16.74,
      "text": "今天就来探讨一下韩国的KF-21猎鹰战斗机"
    },
    {
      "s": 16.74,
      "e": 18.64,
      "text": "初见它是菱形机头"
    },
    {
      "s": 18.64,
      "e": 20.0,
      "text": "倾斜双锤尾"
    },
    {
      "s": 20.0,
      "e": 23.08,
      "text": "简直就是F-22和F-35的结合体"
    },
    {
      "s": 23.08,
      "e": 24.54,
      "text": "而最让人惊讶的是"
    },
    {
      "s": 24.54,
      "e": 27.14,
      "text": "作为号称具备隐身能力的战机"
    },
    {
      "s": 27.14,
      "e": 28.96,
      "text": "它的导弹竟全部外挂"
    },
    {
      "s": 28.96,
      "e": 30.18,
      "text": "没有内置弹舱"
    },
    {
      "s": 30.18,
      "e": 32.96,
      "text": "这隐身性能无疑会大幅削弱"
    },
    {
      "s": 32.96,
      "e": 36.4,
      "text": "KF-21承载着韩国航空工业突围的希望"
    },
    {
      "s": 36.4,
      "e": 39.56,
      "text": "也是当下韩国空军重点量产的机型"
    },
    {
      "s": 39.56,
      "e": 41.4,
      "text": "它采用双发中型布局"
    },
    {
      "s": 41.4,
      "e": 44.24,
      "text": "配备两台美制F-41四发动机"
    },
    {
      "s": 44.24,
      "e": 46.74,
      "text": "与美军超级大黄蜂动力相同"
    },
    {
      "s": 46.74,
      "e": 49.42,
      "text": "极限速度可达1.8马赫"
    },
    {
      "s": 49.42,
      "e": 51.22,
      "text": "最大载弹量7.7吨"
    },
    {
      "s": 51.22,
      "e": 53.42,
      "text": "机上装备韩国自主研发"
    },
    {
      "s": 53.42,
      "e": 55.14,
      "text": "有源相控阵雷达"
    },
    {
      "s": 55.14,
      "e": 57.2,
      "text": "搭配红外光电探测系统"
    },
    {
      "s": 57.2,
      "e": 59.76,
      "text": "在超视距空战方面有一定基础"
    },
    {
      "s": 59.76,
      "e": 61.52,
      "text": "共有10个武器挂点"
    },
    {
      "s": 61.52,
      "e": 63.56,
      "text": "可搭载流星中距空空弹"
    },
    {
      "s": 63.56,
      "e": 65.32,
      "text": "金牛座巡航导弹"
    },
    {
      "s": 65.32,
      "e": 66.6,
      "text": "既能进行空战"
    },
    {
      "s": 66.6,
      "e": 68.54,
      "text": "也能实施对地打击"
    },
    {
      "s": 68.54,
      "e": 71.5,
      "text": "但它存在一个至今难以回避的致命缺陷"
    },
    {
      "s": 71.5,
      "e": 73.18,
      "text": "没有真正的内置弹舱"
    },
    {
      "s": 73.18,
      "e": 74.8,
      "text": "仅有基附半埋挂架"
    },
    {
      "s": 74.8,
      "e": 76.7,
      "text": "大部分弹药只能外挂"
    },
    {
      "s": 76.7,
      "e": 77.98,
      "text": "一旦挂载武器"
    },
    {
      "s": 77.98,
      "e": 79.88,
      "text": "隐身外形便会失效"
    },
    {
      "s": 79.88,
      "e": 81.88,
      "text": "雷达反射面积急剧增大"
    },
    {
      "s": 81.88,
      "e": 84.92,
      "text": "与标准五代机的隐身要求相差甚远"
    },
    {
      "s": 84.92,
      "e": 87.04,
      "text": "这也是全球多数军事专家"
    },
    {
      "s": 87.04,
      "e": 89.98,
      "text": "仅将其归为四代半战机的关键因素"
    },
    {
      "s": 89.98,
      "e": 92.24,
      "text": "实际上韩国人心里明白得很"
    },
    {
      "s": 92.24,
      "e": 93.34,
      "text": "他们直接表明"
    },
    {
      "s": 93.34,
      "e": 95.06,
      "text": "我们不跟F35比拼"
    },
    {
      "s": 95.06,
      "e": 96.44,
      "text": "绝对隐身能力"
    },
    {
      "s": 96.44,
      "e": 98.26,
      "text": "我们拼的是性价比"
    },
    {
      "s": 98.26,
      "e": 101.26,
      "text": "KF-21定位为4.5代准隐身战机"
    },
    {
      "s": 101.26,
      "e": 104.5,
      "text": "虽然武器外路使雷达反射面比五代机大"
    },
    {
      "s": 104.5,
      "e": 106.96,
      "text": "但比传统的F16强多了"
    },
    {
      "s": 106.96,
      "e": 108.52,
      "text": "既然隐身能力比不过"
    },
    {
      "s": 108.52,
      "e": 110.18,
      "text": "那就比拼先迪发现"
    },
    {
      "s": 110.18,
      "e": 111.68,
      "text": "先迪开火的能力"
    },
    {
      "s": 111.68,
      "e": 114.52,
      "text": "它配备了韩国自研的有源相控阵雷达"
    },
    {
      "s": 114.52,
      "e": 116.0,
      "text": "搭配流星超市"
    },
    {
      "s": 116.0,
      "e": 117.18,
      "text": "距空空导弹"
    },
    {
      "s": 117.18,
      "e": 119.34,
      "text": "主打一个我可能被你看见"
    },
    {
      "s": 119.34,
      "e": 121.18,
      "text": "但我能先消灭你的理念"
    },
    {
      "s": 121.18,
      "e": 122.02,
      "text": "更厉害的是"
    },
    {
      "s": 122.02,
      "e": 125.44,
      "text": "这架战机大量采用美国通用电器的发动机"
    },
    {
      "s": 125.44,
      "e": 127.06,
      "text": "和北约制式武器"
    },
    {
      "s": 127.06,
      "e": 130.98,
      "text": "韩国不仅计划采购120架来替换老旧战机"
    },
    {
      "s": 130.98,
      "e": 132.88,
      "text": "还拉上印尼共同投资"
    },
    {
      "s": 132.88,
      "e": 136.18,
      "text": "甚至将目标瞄准了菲律宾等东南亚市场"
    },
    {
      "s": 136.18,
      "e": 138.16,
      "text": "用五代机一半的价格"
    },
    {
      "s": 138.16,
      "e": 139.9,
      "text": "买4.5代的性能"
    }
  ],
  "chapters": []
}