  "lines": [
    {
      "s": 0.56,
      "e": 3.92,
      "text": "昨天 韩国空军等来了历史性一刻"
    },
    {
      "s": 3.92,
      "e": 7.7,
      "text": "首架量产型KF-21猎鹰正式交付"
    },
    {
      "s": 7.7,
      "e": 9.96,
      "text": "但很少有人注意到"
    },
    {
      "s": 9.96,
      "e": 12.86,
      "text": "这架被韩国人寄予厚望的战机"
    },
    {
      "s": 12.86,
      "e": 15.74,
      "text": "机腹下面竟然没有弹舱"
    },
    {
      "s": 15.74,
      "e": 19.92,
      "text": "画面里 这架尾号26-001的双座机"
    },
    {
      "s": 19.92,
      "e": 24.08,
      "text": "昨天下午从Kai四川工厂的机库中缓缓滑出"
    },
    {
      "s": 24.08,
      "e": 27.0,
      "text": "地勤穿着反光背心一路引导"
    },
    {
      "s": 27.0,
      "e": 29.34,
      "text": "飞行员在座舱里抬手致意"
    },
    {
      "s": 29.34,
      "e": 31.28,
      "text": "紧接着起飞 爬升"
    },
    {
      "s": 31.28,
      "e": 35.62,
      "text": "在空中和T-50精英教练机组成四机编队通场"
    },
    {
      "s": 35.62,
      "e": 37.16,
      "text": "最后主轮接地"
    },
    {
      "s": 37.16,
      "e": 40.5,
      "text": "轮胎在跑道上擦出白烟 稳稳减速"
    },
    {
      "s": 40.5,
      "e": 43.28,
      "text": "整套交付飞行一气呵成"
    },
    {
      "s": 43.28,
      "e": 47.2,
      "text": "说实话 这个空优涂装 菱形机头和做工"
    },
    {
      "s": 47.2,
      "e": 50.02,
      "text": "确实能看出韩国航空工业的底子"
    },
    {
      "s": 50.02,
      "e": 53.52,
      "text": "但热闹背后有三个细节值得掰开"
    },
    {
      "s": 53.52,
      "e": 57.68,
      "text": "第一 它为什么叫4.5代而不是5代机"
    },
    {
      "s": 57.68,
      "e": 61.66,
      "text": "KF-21外形确实像缩小版F-22"
    },
    {
      "s": 61.66,
      "e": 65.4,
      "text": "菱形机头 双外轻垂尾 加莱特进气道"
    },
    {
      "s": 65.4,
      "e": 67.04,
      "text": "该有的隐身设计都有"
    },
    {
      "s": 67.04,
      "e": 69.7,
      "text": "但它没有真正的内埋弹舱"
    },
    {
      "s": 69.7,
      "e": 72.46,
      "text": "机腹只有四个半埋式挂架"
    },
    {
      "s": 72.46,
      "e": 74.52,
      "text": "导弹一半漏在外面"
    },
    {
      "s": 74.52,
      "e": 78.5,
      "text": "这意味着只要挂弹隐身效果就要打折扣"
    },
    {
      "s": 78.5,
      "e": 81.26,
      "text": "韩国自己的定位也很务实"
    },
    {
      "s": 81.26,
      "e": 84.76,
      "text": "四代半比F-16强 比F-35差半大"
    },
    {
      "s": 84.76,
      "e": 87.9,
      "text": "第二 这架飞机真是韩国造吗"
    },
    {
      "s": 87.9,
      "e": 92.34,
      "text": "目前 KF-21的国产化率大约65%"
    },
    {
      "s": 92.34,
      "e": 94.52,
      "text": "最核心的两台发动机"
    },
    {
      "s": 94.52,
      "e": 100.48,
      "text": "是美国通用电器的F-414和FA-8TEF超级大黄蜂同款"
    },
    {
      "s": 100.48,
      "e": 103.16,
      "text": "单台加力推力约9.8吨"
    },
    {
      "s": 103.16,
      "e": 108.88,
      "text": "有源相控阵雷达 电子战系统也有相当比例依赖进口"
    },
    {
      "s": 108.88,
      "e": 110.36,
      "text": "更准确地说"
    },
    {
      "s": 110.36,
      "e": 113.78,
      "text": "这是一架韩国总装的国际合作战机"
    },
    {
      "s": 113.78,
      "e": 117.56,
      "text": "第三 当年那个印尼合伙人呢"
    },
    {
      "s": 117.56,
      "e": 119.94,
      "text": "项目启动时拉印尼入伙"
    },
    {
      "s": 119.94,
      "e": 123.42,
      "text": "说好印尼承担20%研发费"
    },
    {
      "s": 123.42,
      "e": 124.96,
      "text": "采购50架"
    },
    {
      "s": 124.96,
      "e": 127.32,
      "text": "结果印尼经济扛不住"
    },
    {
      "s": 127.32,
      "e": 131.24,
      "text": "后来要求把出资比例砍到7.5%"
    },
    {
      "s": 131.24,
      "e": 134.08,
      "text": "还取消了在印尼建生产线的计划"
    },
    {
      "s": 134.08,
      "e": 137.34,
      "text": "现在基本变成普通采购客户"
    },
    {
      "s": 137.34,
      "e": 141.34,
      "text": "从2015年12月正式启动系统开发"
    },
    {
      "s": 141.34,
      "e": 142.8,
      "text": "到昨天交付"
    },
    {
      "s": 142.8,
      "e": 145.04,
      "text": "韩国走了将近10年"
    },
    {
      "s": 145.04,
      "e": 149.18,
      "text": "计划到2032年装备120架"
    },
    {
      "s": 149.18,
      "e": 152.48,
      "text": "替换老旧的F-4和F-5机队"
    },
    {
      "s": 152.48,
      "e": 153.96,
      "text": "怎么评价"
    },
    {
      "s": 153.96,
      "e": 158.84,
      "text": "韩国从零造出一款能飞能打的超音速战斗机"
    },
    {
      "s": 158.84,
      "e": 161.34,
      "text": "工业体系确实不容小觑"
    },
    {
      "s": 161.34,
      "e": 164.68,
      "text": "但要靠它挤进真正的五代机俱乐部"
    },
    {
      "s": 164.68,
      "e": 169.3,
      "text": "还差一个内埋弹仓和一颗完全自主的心脏"
    },
    {
      "s": 169.3,
      "e": 170.22,
      "text": "巨大建议"
    },
    {
      "s": 170.22,
      "e": 170.66,
      "text": "巨大建议"
    },
    {
      "s": 170.66,
      "e": 171.54,
      "text": "巨大建议"
    }
  ],
