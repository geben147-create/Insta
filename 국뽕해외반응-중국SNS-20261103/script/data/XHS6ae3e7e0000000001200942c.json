  "lines": [
    {
      "s": 0.26,
      "e": 3.3,
      "text": "什么?韩国也有双座隐身战斗机了?"
    },
    {
      "s": 4.32,
      "e": 5.56,
      "text": "先问大家一个问题"
    },
    {
      "s": 5.56,
      "e": 8.1,
      "text": "同样是双座隐身战斗机"
    },
    {
      "s": 8.1,
      "e": 10.84,
      "text": "韩国刚刚服役的KF-21"
    },
    {
      "s": 10.84,
      "e": 13.98,
      "text": "能不能复刻我们歼20S的王牌能力"
    },
    {
      "s": 13.98,
      "e": 16.14,
      "text": "指挥无人机编队作战呢?"
    },
    {
      "s": 17.1,
      "e": 17.98,
      "text": "我是农同学"
    },
    {
      "s": 17.98,
      "e": 21.02,
      "text": "收藏了全球50欧超500架军灰和装备"
    },
    {
      "s": 21.02,
      "e": 23.58,
      "text": "就在9月22号的下午"
    },
    {
      "s": 23.58,
      "e": 27.2,
      "text": "韩国自研的KF-21猎鹰准古代机"
    },
    {
      "s": 27.2,
      "e": 29.22,
      "text": "正式的交付韩国空军"
    },
    {
      "s": 29.22,
      "e": 30.52,
      "text": "陆列服役了"
    },
    {
      "s": 30.52,
      "e": 32.92,
      "text": "这001号量产机到位"
    },
    {
      "s": 32.92,
      "e": 34.82,
      "text": "就意味着这款机型"
    },
    {
      "s": 34.82,
      "e": 36.94,
      "text": "彻底结束了试验的阶段"
    },
    {
      "s": 36.94,
      "e": 38.3,
      "text": "进入实战部署"
    },
    {
      "s": 38.3,
      "e": 40.2,
      "text": "韩国也靠着它"
    },
    {
      "s": 40.2,
      "e": 43.92,
      "text": "挤进了隐身战斗机自研量产的圈子"
    },
    {
      "s": 43.92,
      "e": 46.16,
      "text": "韩国航空工业进步还真快"
    },
    {
      "s": 46.16,
      "e": 47.22,
      "text": "但我仔细一看"
    },
    {
      "s": 47.22,
      "e": 49.46,
      "text": "发现了一个特别关键的点"
    },
    {
      "s": 49.46,
      "e": 52.04,
      "text": "这次正式服役的KF-21"
    },
    {
      "s": 52.04,
      "e": 53.72,
      "text": "居然是双座版"
    },
    {
      "s": 53.72,
      "e": 55.8,
      "text": "总航的都清楚"
    },
    {
      "s": 55.8,
      "e": 58.78,
      "text": "我们的歼20S双座隐身战斗机"
    },
    {
      "s": 58.78,
      "e": 61.08,
      "text": "根本不是用来教学训练的"
    },
    {
      "s": 61.08,
      "e": 63.18,
      "text": "它的核心定位非常清晰"
    },
    {
      "s": 63.18,
      "e": 65.5,
      "text": "那就是空中移动指挥中枢"
    },
    {
      "s": 65.5,
      "e": 67.54,
      "text": "专门带队指挥无人尿机"
    },
    {
      "s": 67.54,
      "e": 70.22,
      "text": "实现有人战机和无人机的协同空战"
    },
    {
      "s": 70.22,
      "e": 72.4,
      "text": "那有人心里肯定会犯嘀咕"
    },
    {
      "s": 72.4,
      "e": 75.16,
      "text": "韩国现在也推出双座的隐身战斗机"
    },
    {
      "s": 75.16,
      "e": 79.22,
      "text": "难道它的战术定位和我们的J-20S是一样的吗"
    },
    {
      "s": 79.22,
      "e": 82.78,
      "text": "也具备无人机编队的指挥核心能力"
    },
    {
      "s": 82.78,
      "e": 86.32,
      "text": "接着我直接就把核心结论说在前面"
    },
    {
      "s": 86.32,
      "e": 88.98,
      "text": "这两个看着外观是有点像"
    },
    {
      "s": 88.98,
      "e": 91.16,
      "text": "实际上完全是两码事"
    },
    {
      "s": 91.16,
      "e": 92.58,
      "text": "根本就没有可比性"
    },
    {
      "s": 92.58,
      "e": 94.82,
      "text": "实力更是天差地别"
    },
    {
      "s": 94.82,
      "e": 97.82,
      "text": "先说说咱们的J-20S"
    },
    {
      "s": 97.82,
      "e": 99.78,
      "text": "为什么是全球独一份的存在"
    },
    {
      "s": 99.78,
      "e": 103.1,
      "text": "我们研发J-20S双座版"
    },
    {
      "s": 103.1,
      "e": 104.34,
      "text": "从立项之初"
    },
    {
      "s": 104.34,
      "e": 106.1,
      "text": "目标就极其的明确"
    },
    {
      "s": 106.1,
      "e": 109.02,
      "text": "就是为了下一代体系化空战"
    },
    {
      "s": 109.02,
      "e": 113.28,
      "text": "前座的飞行员专注驾驶战斗机"
    },
    {
      "s": 113.28,
      "e": 115.4,
      "text": "应对空战把控全局态势"
    },
    {
      "s": 115.4,
      "e": 118.38,
      "text": "后座的飞行员不用管基础的飞行"
    },
    {
      "s": 118.38,
      "e": 120.16,
      "text": "专门负责统筹战场"
    },
    {
      "s": 120.16,
      "e": 121.94,
      "text": "调度多架无人尿机"
    },
    {
      "s": 121.94,
      "e": 124.26,
      "text": "完成超视距的协同打击"
    },
    {
      "s": 124.26,
      "e": 126.94,
      "text": "简单来说J-20S"
    },
    {
      "s": 126.94,
      "e": 130.1,
      "text": "就是一台会飞的空中指挥所"
    },
    {
      "s": 130.1,
      "e": 133.26,
      "text": "这套有人无人协同的作战体系"
    },
    {
      "s": 133.26,
      "e": 135.14,
      "text": "我们是已经完全落地"
    },
    {
      "s": 135.14,
      "e": 137.64,
      "text": "经过多次实战化的验证"
    },
    {
      "s": 137.64,
      "e": 139.34,
      "text": "是成熟可靠"
    },
    {
      "s": 139.34,
      "e": 141.34,
      "text": "随时能战的现役战力"
    },
    {
      "s": 141.34,
      "e": 144.88,
      "text": "再看韩国刚服役的双座KF-21"
    },
    {
      "s": 144.88,
      "e": 147.96,
      "text": "真相是直接就戳破泡沫了"
    },
    {
      "s": 147.96,
      "e": 151.46,
      "text": "首先它根本就算不上正统的五代机"
    },
    {
      "s": 151.46,
      "e": 155.32,
      "text": "只是一款4.5代的准引身战斗机"
    },
    {
      "s": 155.32,
      "e": 157.34,
      "text": "没有专用的内置战舱"
    },
    {
      "s": 157.34,
      "e": 160.16,
      "text": "隐身性能的短板是非常明显的"
    },
    {
      "s": 160.16,
      "e": 162.02,
      "text": "先天底子就和纯正的五代机"
    },
    {
      "s": 162.02,
      "e": 162.78,
      "text": "差了一大几"
    },
    {
      "s": 162.78,
      "e": 164.8,
      "text": "最关键的一点"
    },
    {
      "s": 164.8,
      "e": 167.78,
      "text": "目前服役的这批双座KF-21"
    },
    {
      "s": 167.78,
      "e": 170.48,
      "text": "唯一的功能就是飞行员训练"
    },
    {
      "s": 170.48,
      "e": 173.12,
      "text": "它的后座就是纯教学的席位"
    },
    {
      "s": 173.12,
      "e": 175.8,
      "text": "没有搭载任何无人机的指挥系统"
    },
    {
      "s": 175.8,
      "e": 178.98,
      "text": "也没有配到高端的数据链融合设备"
    },
    {
      "s": 178.98,
      "e": 181.1,
      "text": "只能用来带新人练手"
    },
    {
      "s": 181.1,
      "e": 185.16,
      "text": "完全就不具备我们G20S的核心战术能力"
    },
    {
      "s": 185.16,
      "e": 188.38,
      "text": "韩国也是有野心的"
    },
    {
      "s": 188.38,
      "e": 190.3,
      "text": "并不是单纯的跟风"
    },
    {
      "s": 190.3,
      "e": 192.16,
      "text": "按照他们的官方的规划"
    },
    {
      "s": 192.16,
      "e": 196.78,
      "text": "要等到2028年升级新的版本"
    },
    {
      "s": 196.78,
      "e": 199.28,
      "text": "才会尝试加装协同作战系统"
    },
    {
      "s": 199.28,
      "e": 201.62,
      "text": "搭配他们自研的无人机"
    },
    {
      "s": 201.62,
      "e": 204.1,
      "text": "打造所谓的无人料机体系"
    },
    {
      "s": 204.1,
      "e": 206.04,
      "text": "说白了就是"
    },
    {
      "s": 206.04,
      "e": 209.58,
      "text": "我们的双座隐身战斗机协同作战"
    },
    {
      "s": 209.58,
      "e": 212.04,
      "text": "是已经落地的实战能力"
    },
    {
      "s": 212.04,
      "e": 213.86,
      "text": "而韩国的这套体系"
    },
    {
      "s": 213.86,
      "e": 215.5,
      "text": "只是一个遥遥无期"
    },
    {
      "s": 215.5,
      "e": 217.46,
      "text": "还没有落地的未来的规划"
    },
    {
      "s": 217.46,
      "e": 220.14,
      "text": "这外形是可以模仿"
    },
    {
      "s": 220.14,
      "e": 221.6,
      "text": "布局也是可以照搬"
    },
    {
      "s": 221.6,
      "e": 224.0,
      "text": "但核心技术和空战的体系"
    },
    {
      "s": 224.0,
      "e": 225.94,
      "text": "是绝对抄不走的"
    },
    {
      "s": 225.94,
      "e": 227.8,
      "text": "目前全球范围内"
    },
    {
      "s": 227.8,
      "e": 231.74,
      "text": "只有我们中国拥有双座版本的隐身战斗机"
    },
    {
      "s": 231.74,
      "e": 234.98,
      "text": "这可不是简单的五代机技术门槛"
    },
    {
      "s": 234.98,
      "e": 236.82,
      "text": "而是我们中国韩国工业"
    },
    {
      "s": 236.82,
      "e": 240.8,
      "text": "在引领全球下一代隐身战机的发展方向"
    },
    {
      "s": 240.8,
      "e": 244.26,
      "text": "韩国的KF-21顶多算是国防跟风"
    },
    {
      "s": 244.26,
      "e": 248.32,
      "text": "而我们的歼20S才是真正的行业标杆"
    },
    {
      "s": 248.32,
      "e": 250.4,
      "text": "妥妥了全球独一份"
    },
    {
      "s": 250.4,
      "e": 252.26,
      "text": "我是农同学"
    },
    {
      "s": 252.26,
      "e": 253.32,
      "text": "你是装备库"
    },
    {
      "s": 253.32,
      "e": 254.56,
      "text": "我们下期见"
    }
  ],
